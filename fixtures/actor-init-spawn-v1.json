{
  "schema": "oreslang.actor-init-spawn.v1",
  "status": "PROPOSED_SOURCE_FREE_NOT_EXECUTED",
  "design": {
    "initialization_hook": "init",
    "actor_constructor_allowed": false,
    "initializer_invoked_through": "spawn Actor(named arguments)",
    "init_before_ref_publication": true,
    "initialized_state_location": "single compiler-owned state schema",
    "state_builder": "complete non-escaping compiler-owned value",
    "mutation_method": "self.handle_state(critical[write] ...)",
    "reflective_service_locator_allowed": false,
    "async_init_allowed": false,
    "hot_reload_reruns_init": false,
    "durable_restore_reruns_init": false,
    "implicit_future_or_option_flattening": false,
    "per_tenant_authority_required": true,
    "init_on_start_coexistence_allowed": false,
    "dependency_binding_kind": "val",
    "mutable_business_state_binding_kind": "let"
  },
  "defaults": {
    "actor_constructor": false,
    "init_count": 1,
    "actor_external_init": false,
    "init_params": [
      "store",
      "gateway"
    ],
    "spawn_args": [
      "store",
      "gateway"
    ],
    "arg_types_match": true,
    "implicit_conversion": false,
    "dep_generation_valid": true,
    "dep_tenant_authorized": true,
    "dep_cross_isolate_brokered": true,
    "deps_capability_authorized": true,
    "deps_ownership_safe": true,
    "init_effect": "pure",
    "state_keys": [
      "store",
      "gateway",
      "phase"
    ],
    "state_return_keys": [
      "store",
      "gateway",
      "phase"
    ],
    "state_has_defaults": false,
    "state_types_match": true,
    "state_builder_private": true,
    "published_before_commit": false,
    "init_runs": 1,
    "init_failed": false,
    "rollback_complete": true,
    "restoring": false,
    "restore_rebound_authorized": true,
    "graph_cycle": false,
    "budget_ok": true,
    "ambient_resolution": false,
    "mutation_via_sealed_write": true,
    "hard_rt": false,
    "init_bounded": true,
    "has_on_start": false,
    "rebind_immutable_dependency": false
  },
  "cases": [
