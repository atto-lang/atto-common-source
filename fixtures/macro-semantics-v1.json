{
  "schema": "oreslang.macro-semantics.v1",
  "status": "SOURCE_CONTRACT_ONLY",
  "declaration": {
    "compile_time_only": true,
    "private_by_default": true,
    "pub_is_compile_time_api_only": true,
    "explicit_result_kind_required": true,
    "first_class_runtime_value": false,
    "generated_macro_declarations": false
  },
  "meta_types": [
    "Type",
    "Const<T>",
    "Identifier",
    "Syntax<Expr>",
    "Syntax<Stmt>",
    "Syntax<Decl>",
    "Syntax<Type>",
    "Syntax<Pattern>",
    "SyntaxList<Decl>"
  ],
  "invocation": {
    "canonical_spelling": "name!(...)",
    "ordinary_runtime_call": false,
    "argument_categories_explicit": true,
    "type_prefix": "type",
    "const_prefix": "const",
    "identifier_prefix": "ident",
    "syntax_prefix": "syntax",
    "identifier_is_checked_capture": false,
    "declaration_result_kinds": [
      "Syntax<Decl>",
      "SyntaxList<Decl>"
    ],
    "expression_result_kinds": [
      "Syntax<Expr>"
    ],
    "runtime_const_fallback": false,
    "identifier_is_hygienic_provenance": true,
    "capture_requires_explicit_checked_operation": true,
    "qualified_lookup_obeys_visibility": true,
    "const_type_must_match": true
  },
  "ast": {
    "typed_not_text": true,
    "raw_token_streams": false,
    "parse_generated_source": false,
    "provenance_required": true,
    "hygienic_by_default": true,
    "hygiene_identity_exact": true,
    "hash_collision_grants_identity": false,
    "runtime_hygiene_table_required": false,
    "explicit_checked_capture_only": true,
    "transactional_provenance_publication": true,
    "splice_and_const_quote_origins_distinct": true
  },
  "generated_namespace": {
    "ordinary_declarations": true,
    "package_or_module_header": false,
    "imports_or_aliases": false,
    "exports_or_reexports": false,
    "macros": false,
    "build_manifest_or_flags": false
  },
  "phase_order": [
    "parse",
    "resolve_macro_imports",
    "bind_macro_signatures",
    "compile_macro_bodies",
    "resolve_macro_arguments",
    "expand",
    "reject_residual_macros",
    "ordinary_semantic_checks",
    "finite_generic_closure",
    "backend_codegen"
  ],
  "determinism": {
    "expansion_key": [
      "macro_content_hash",
      "canonical_typed_arguments",
      "declared_build_inputs",
      "explicit_target_profile_features",
      "macro_semantics_abi"
    ],
    "ambient_time": false,
    "ambient_random": false,
    "undeclared_env": false,
    "arbitrary_files": false,
    "network": false,
    "mutable_global_state_observable": false,
    "target_independent_hash_parity": true
  },
  "authority": {
    "ffi": false,
    "raw_pointer": false,
    "actor_runtime": false,
    "supervisor_runtime": false,
    "runtime_task_future_thread": false,
    "runtime_ownership_ops": false,
    "diagnostics_side_channel_only": true
  },
  "generics": {
    "generated_generics_allowed": true,
    "concrete_runtime_specialization_hook": false,
    "finite_feedback_required": true,
    "unavailable_concrete_metadata_is_compile_error": true
  },
  "resources": {
    "deterministic_budgets_required": true,
    "budget_profile_in_cache_identity": true,
    "expansion_transactional": true,
    "runtime_fallback": false,
    "active_cycle_detection": true
  },
