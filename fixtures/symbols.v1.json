  "syntax": [
    {
      "source": "final Symbol foo: :ready",
      "expected": "accept",
      "notes": "first colon is field initializer separator, second begins Symbol literal"
    },
    {
      "source": "final int foo: :ready",
      "expected": "type_error",
      "notes": "typed int cannot be initialized from Symbol; no syntax ambiguity"
    },
    {
      "source": "final Symbol foo = :ready",
      "expected": "accept",
      "notes": "optional compatibility initializer spelling"
    },
    {
      "source": "let x = infer struct{foo: :ready}",
      "expected": "accept",
      "notes": "container consumes the first colon; expression parser consumes next"
    },
    {
      "source": "let x = struct{foo: Symbol}{foo: :ready}",
      "expected": "accept",
      "notes": "shape field annotation followed by literal in initializer"
    },
    {
      "source": "let x = infer struct{foo: :}",
      "expected": "parse_error",
      "notes": "literal name missing"
    },
    {
      "source": "let x = infer struct{foo: :123}",
      "expected": "parse_error",
      "notes": "Symbol literal requires identifier"
    },
    {
      "source": "let x = infer struct{foo:}",
      "expected": "parse_error",
      "notes": "field value missing"
    }
  ],
