  "visibility_policy": {
    "std_core_manifest": {
      "version": "core-symbols-v1-fixture",
      "allowed_process_keys": [
        "ready",
        "error",
        "Symbol.iterator"
      ]
    },
    "private_userland_process_keys": [
      "userland/secret",
      "userland/ready"
    ],
    "scoped_userland_exports": [
      {
        "tenant": "tenant-a",
        "endpoint": "actor-notification",
        "protocol": "v1",
        "allowed_process_keys": [
          "userland/alert"
        ]
      }
    ]
  },
  "syntax": [
    {
      "source": "final Symbol foo: #abc",
      "expected": "accept",
      "notes": "colon separator followed by atomic hash-Symbol literal"
    },
    {
      "source": "final int foo: #ready",
      "expected": "type_error",
      "notes": "Symbol is nominally distinct from int"
    },
    {
      "source": "final Symbol foo = #ready",
      "expected": "accept",
      "notes": "compatibility initializer spelling"
    },
    {
      "source": "let a: Symbol = #ready",
      "expected": "accept",
      "notes": "typed Symbol value"
    },
    {
      "source": "let m = (#user_joined, 42)",
      "expected": "accept",
      "notes": "Symbol in tuple"
    },
    {
      "source": "let x = infer struct{foo: #ready}",
      "expected": "accept",
      "notes": "struct colon is separator, hash belongs to value"
    },
    {
      "source": "let x = struct{foo: Symbol}{foo: #ready}",
      "expected": "accept",
      "notes": "explicit typed struct initializer"
    },
    {
      "source": "let y = #'ready foo'",
      "expected": "accept",
      "notes": "single-quoted Symbol with spaces"
    },
    {
      "source": "let y = #\"ready foo\"",
      "expected": "accept",
      "notes": "double-quoted Symbol with spaces"
    },
    {
      "source": "let y = #\"http.ok\"",
      "expected": "accept",
      "notes": "Symbol containing punctuation"
    },
    {
      "source": "let y = #true",
      "expected": "accept",
      "notes": "hash lexer consumes keyword-like name"
    },
    {
      "source": "let y = #class",
      "expected": "accept",
      "notes": "reserved keyword works as Symbol name"
    },
    {
      "source": "let y = #",
      "expected": "parse_error",
      "notes": "hash lacks a name"
    },
    {
      "source": "let y = # ready",
      "expected": "parse_error",
      "notes": "whitespace between hash and literal forbidden"
    },
    {
      "source": "let y = #123",
      "expected": "parse_error",
      "notes": "numeric name not an identifier"
    },
    {
      "source": "let y = :ready",
      "expected": "parse_error",
      "notes": "Ruby-style colon literals explicitly rejected"
    },
    {
      "source": "let x = infer struct{foo: :ready}",
      "expected": "parse_error",
      "notes": "prior ambiguous double-colon form not supported"
    },
    {
      "source": "let x = infer struct{foo:}",
      "expected": "parse_error",
      "notes": "field value missing"
    },
    {
      "source": "let y = new Symbol('ready')",
      "expected": "type_error",
      "notes": "v1 no constructor; use Symbol.process('ready')"
    },
    {
      "source": "let y = Symbol.process('ready')",
      "expected": "accept",
      "notes": "trusted runtime path; logically equal to #ready"
    }
  ],
