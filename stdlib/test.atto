// Candidate Atto-native pure std.test core, migrated from the native Oreslang
// stdlib/testing.ores runner. Pending real .atto compiler/guest validation.
// No global registry, no before_each hook and no ambient I/O.
define module test as

  type TestBody = () => TestOutcome;

  pub define class TestOutcome as
    pub val bool passed;
    pub val String message;
  end

  pub define class TestCase as
    pub val String name;
    pub val TestBody body;
    pub val bool skipped;
    pub val String skip_reason;
  end

  pub define class TestSuite as
    pub val String name;
    pub val List<TestCase> tests;
  end

  pub define class TestOptions as
    pub val String only;
    pub val bool fail_fast;
  end

  pub define class RunSummary as
    pub val int total;
    pub val int passed;
    pub val int failed;
    pub val int skipped;
    pub val int filtered;
    pub val String first_failure;
  end

  pub fnc pass(): TestOutcome {
    return new TestOutcome(true, "");
  }

  pub fnc fail(String message): TestOutcome {
    return new TestOutcome(false, message);
  }

  pub fnc expect_true(bool actual, String message): TestOutcome {
    if actual; do
      return pass();
    fi
    return fail(message);
  }

  pub fnc expect_false(bool actual, String message): TestOutcome {
    if !actual; do
      return pass();
    fi
    return fail(message);
  }

  pub fnc expect_equal_int(int actual, int expected, String message): TestOutcome {
    if actual eq expected; do
      return pass();
    fi
    return fail(message);
  }

  pub fnc expect_equal_string(String actual, String expected, String message): TestOutcome {
    if actual eq expected; do
      return pass();
    fi
    return fail(message);
  }

  // The public snake_case builders avoid reliance on global registration.
  pub fnc test_case(String name, TestBody body): TestCase {
    return new TestCase(name, body, false, "");
  }

  pub fnc test_suite(String name, List<TestCase> cases): TestSuite {
    return new TestSuite(name, cases);
  }

  fnc skipped_body(): TestOutcome {
    // Deliberately never invoked by run_suite when the skip flag is set.
    return pass();
  }

  pub fnc skip_case(String name, String reason): TestCase {
    return new TestCase(name, skipped_body, true, reason);
  }

  fnc selected(String full_name, String only): bool {
    if only eq ""; do
      return true;
    fi
    return full_name eq only;
  }

  // This is a pure results collector. An external reporter decides whether
  // and how to print the result, and tests do not acquire stdout implicitly.
  // Actual input body purity and capture isolation require compiler checks.
  pub fnc run_suite(borrow TestSuite suite, borrow TestOptions options): RunSummary {
    let int total = 0;
    let int passed_count = 0;
    let int failed_count = 0;
    let int skipped_count = 0;
    let int filtered_count = 0;
    let String first_failure = "";
    let String suite_name = suite.name;
    let List<TestCase> cases = suite.tests;
    let String only = options.only;
    let bool fail_fast = options.fail_fast;

    for const test_case of cases do
      let String full_name = suite_name + "/" + test_case.name;
      if !selected(full_name, only); do
        filtered_count = filtered_count + 1;
        continue;
      fi
      total = total + 1;
      if test_case.skipped; do
        skipped_count = skipped_count + 1;
        continue;
      fi
      let TestOutcome outcome = test_case.body();
      if outcome.passed; do
        passed_count = passed_count + 1;
      else
        failed_count = failed_count + 1;
        if first_failure eq ""; do
          first_failure = full_name + ": " + outcome.message;
        fi
        if fail_fast; do
          return new RunSummary(total, passed_count, failed_count, skipped_count, filtered_count, first_failure);
        fi
      fi
    done
    return new RunSummary(total, passed_count, failed_count, skipped_count, filtered_count, first_failure);
  }

end
