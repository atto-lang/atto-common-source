// Hosted std convenience functions built on the alloc layer, with no I/O.
// Equality short-circuits: NOT constant-time, never use for secrets.
import module alloc_bytes from "stdlib/alloc/byte_region.atto";

pub fnc bytes_equal(alloc_bytes.ByteRegion left, alloc_bytes.ByteRegion right) -> bool throws Error {
  if left.length() != right.length() then return false; fi
  let int index = 0;
  while index < left.length() do
    if left.read_byte(index) != right.read_byte(index) then return false; fi
    index = index + 1;
  end
  return true;
}
