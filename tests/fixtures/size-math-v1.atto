// Expected exit 42 from a real linked compiler, not a host model.
import module sizes from "../../stdlib/core/size_math.atto";

pub fnc main(): int {
  if sizes.size_mul_fits(1, 1, 0) then return 1; fi
  if !sizes.size_mul_fits(0, 9223372036854775807, 0) then return 2; fi
  if sizes.size_mul_fits(-1, 0, 0) then return 3; fi
  if sizes.size_mul_fits(0, 0, -1) then return 4; fi
  if !sizes.size_mul_fits(9007199254740992, 1, 9007199254740992) then return 5; fi
  if sizes.size_mul_fits(9007199254740993, 1, 9007199254740992) then return 6; fi
  if sizes.size_mul_fits(4611686018427387904, 2, 9223372036854775807) then return 7; fi
  if !sizes.size_mul_fits(4611686018427387903, 2, 9223372036854775807) then return 8; fi
  if !sizes.size_mul_fits(9223372036854775807, 1, 9223372036854775807) then return 9; fi
  if sizes.size_mul_fits(9223372036854775807, 2, 9223372036854775807) then return 10; fi
  if !sizes.size_mul_fits(7, 6, 42) then return 11; fi
  if sizes.size_mul_fits(7, 6, 41) then return 12; fi
  if !sizes.size_mul_fits(6, 7, 42) then return 13; fi
  if sizes.size_mul_fits(6, 7, 41) then return 14; fi
  if !sizes.size_add_fits(9223372036854775806, 1, 9223372036854775807) then return 15; fi
  if sizes.size_add_fits(9223372036854775807, 1, 9223372036854775807) then return 16; fi
  return 42;
}
