      "kind": "span",
      "sampling_divisor": 1
    },
    {
      "id": 28,
      "name": "map.get_optional",
      "kind": "span",
      "sampling_divisor": 1
    },
    {
      "id": 29,
      "name": "map.delete",
      "kind": "span",
      "sampling_divisor": 1
    }
  ]
}
