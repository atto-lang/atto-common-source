{
  "contract_version": "oreslang.package-namespace-multifile.v1",
  "status": "proposed-contract-not-compiler-executed",
  "manifest": ".ores.pkg.toml",
  "manifest_schema": "2 (proposed, requires backend admission)",
  "namespace_declaration": "namespace <flat_ident>;",
  "namespace_import": "import namespace <flat_ident> [as <local_alias>] from \"<verified-package-locator>\";",
  "same_package_locator": "+/",
  "cross_package_locator": "pinned dependency package alias (example: checkout)",
  "assumptions": {
    "package_membership": "Only manifest-listed canonical files belong to a multi-file package; unlisted files are singleton packages.",
    "namespace_membership": "Within one verified package instance, files with the same source namespace header contribute to that namespace.",
    "exports": "Only access-authorized declarations are visible; pub[pkg] is internal to exact package instance; private and pub[file] never cross files.",
    "static_graph": "Import namespace selects a compile-time aggregate, not a runtime module, and never executes imports.",
    "ownership": "Package instance identity includes locked dependency instance and owning manifest, not textual package or namespace name.",
    "duplicates": "A namespace's same-domain exported binding must have one provider, except separately proven legal callable overload families.",
    "zero_implicit_reexport": "An importing file does not publish imported namespace members by default."
  },
  "packages": [
    {
      "id": "checkout@sha256:alpha",
      "key": "checkout",
      "manifest": "checkout/.ores.pkg.toml",
      "files": [
        {
          "path": "src/billing/invoice.ores",
          "header": "namespace billing;",
          "namespace": "billing",
          "exports": [
            {
              "name": "issue",
              "visibility": "pub"
            },
            {
              "name": "internal_sequence",
              "visibility": "private"
            }
          ]
        },
        {
          "path": "src/billing/charges.ores",
          "header": "namespace billing;",
          "namespace": "billing",
          "exports": [
            {
              "name": "charge",
              "visibility": "pub"
            },
            {
              "name": "calculate_fee",
              "visibility": "pub[pkg]"
            }
          ]
        },
        {
          "path": "src/billing/refunds.ores",
          "header": "namespace billing;",
          "namespace": "billing",
          "exports": [
            {
              "name": "refund",
              "visibility": "pub"
            }
          ]
        },
        {
          "path": "src/billing/ledger.ores",
          "header": "namespace billing;",
          "namespace": "billing",
          "exports": [
            {
              "name": "balance",
              "visibility": "pub"
            }
          ]
        },
        {
          "path": "src/identity/accounts.ores",
          "header": "namespace identity;",
          "namespace": "identity",
          "exports": [
            {
              "name": "find_account",
              "visibility": "pub"
            }
          ]
        },
        {
          "path": "src/identity/sessions.ores",
          "header": "namespace identity;",
          "namespace": "identity",
          "exports": [
            {
              "name": "start_session",
              "visibility": "pub"
            }
          ]
        },
        {
          "path": "src/identity/policies.ores",
          "header": "namespace identity;",
          "namespace": "identity",
          "exports": [
            {
              "name": "authorize",
              "visibility": "pub"
            }
          ]
        },
        {
          "path": "src/telemetry/events.ores",
          "header": "namespace telemetry;",
          "namespace": "telemetry",
          "exports": [
            {
              "name": "emit_event",
              "visibility": "pub"
            }
          ]
        },
        {
          "path": "src/telemetry/metrics.ores",
          "header": "namespace telemetry;",
          "namespace": "telemetry",
          "exports": [
            {
              "name": "measure",
              "visibility": "pub"
            }
          ]
        },
        {
          "path": "src/telemetry/traces.ores",
          "header": "namespace telemetry;",
          "namespace": "telemetry",
          "exports": [
            {
              "name": "start_trace",
              "visibility": "pub"
            }
          ]
        }
      ]
    },
    {
      "id": "app@sha256:beta",
      "key": "app",
      "manifest": "app/.ores.pkg.toml",
      "files": [
        {
          "path": "src/main.ores",
          "header": "namespace app;",
          "namespace": "app",
          "exports": [
            {
              "name": "main",
              "visibility": "pub"
            }
          ]
        }
      ]
    },
    {
      "id": "checkout@sha256:gamma",
      "key": "checkout",
      "manifest": "other-checkout/.ores.pkg.toml",
      "files": [
        {
          "path": "src/billing.ores",
          "header": "namespace billing;",
          "namespace": "billing",
          "exports": [
            {
              "name": "issue",
              "visibility": "pub"
            },
            {
              "name": "other",
              "visibility": "pub"
            }
          ]
        }
      ]
    }
  ],
  "reference_cases": [
