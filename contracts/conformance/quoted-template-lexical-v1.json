{
  "schema": 1,
  "id": "atto.quoted-template.lexical.v1",
  "source_extension": ".atto",
  "scope": "compiler frontend lexical and syntactic admission; neither guest String results nor execution receipts",
  "oracle": "Java/Graal and LLVM native ordinary-string semantics, with strict template escapes",
  "semantics": {
    "ordinary_quotes": {
      "delimiters": [
        "'",
        "\""
      ],
      "raw_multiline": "ACCEPT",
      "unknown_escape": "PRESERVE_ESCAPED_CHARACTER",
      "unicode_escape": "four hexadecimal digits; valid surrogate pair required"
    },
    "template": {
      "delimiter": "`",
      "raw_multiline": "ACCEPT",
      "escapes": [
        "n",
        "r",
        "t",
        "\\",
        "'",
        "\"",
        "$",
        "`",
        "uXXXX"
      ],
      "interpolation": "${expression}",
      "comment_only_interpolation": "REJECT",
      "empty_interpolation": "REJECT",
      "interpolated_expression_type": "String; reject numeric coercion",
      "evaluation": "once, left-to-right, when runtime supported"
    },
    "limits": {
      "template_interpolation_frame_depth": 32,
      "interpolation_braces_including_outer": 256,
      "template_substitutions": 1024,
      "portable_block_comment_nesting": 128,
      "above_128_block_comments": "profile-specific until Java/LLVM caps harmonized"
    }
  },
  "backend_evidence": {
    "java": {
      "lexical_source_inspected": true,
      "compiler_executed_for_manifest": false,
      "guest_executed_for_manifest": false,
      "exact_head_ci_verified": false
    },
    "llvm": {
      "lexical_source_inspected": true,
      "compiler_executed_for_manifest": false,
      "guest_executed_for_manifest": false,
      "exact_head_ci_verified": false
    },
    "wasm": {
      "lexical_source_inspected": true,
      "compiler_executed_for_manifest": false,
      "guest_executed_for_manifest": false,
      "exact_head_ci_verified": false
    },
    "forge": {
      "lexical_source_inspected": true,
      "compiler_executed_for_manifest": false,
      "guest_executed_for_manifest": false,
      "exact_head_ci_verified": false
    },
    "net": {
      "lexical_source_inspected": true,
      "compiler_executed_for_manifest": false,
      "guest_executed_for_manifest": false,
      "exact_head_ci_verified": false
    }
  },
  "caveats": [
    "Forge/.NET String guest lowering unsupported; positive lexical fixture must still fail with explicit STRING_BACKEND_UNSUPPORTED.",
    "Wasm host quote preflight is not LLVM wasm32 guest execution.",
    "Java/LLVM comments above depth 128 have not been harmonized; do not claim global negative parity above this ceiling.",
    "No private Git objects may be transferred to unapproved cross-org CI destinations."
  ],
  "cases": [
