{
  "schema_version": "1.0.0",
  "id": "atto.to_string.v1",
  "source_extension": ".atto",
  "scope": "portable prospective semantic contract; compiler/guest status is NOT EXECUTED",
  "semantics": {
    "function": "to_string(value) requires exactly one positional argument of int, bool or String; user-declared fnc with matching arity resolves first",
    "method": "int.to_string(), bool.to_string(), String.to_string() have no explicit arguments; declared class to_string() resolves through nominal method dispatch",
    "int": "signed i64 base-10 ASCII, no locale or grouping",
    "bool": "lowercase true/false",
    "string": "identity, preserves exact decoded Unicode and embedded NUL data",
    "class": "no implicit class-to-String conversion or host Object.toString fallback; classes must explicitly declare to_string(): String",
    "template": "interpolation requires String statically; no implicit scalar/object to_string; each conversion evaluates once in source order",
    "security": "no reflection, automatic class field disclosure, host object stringification, capabilities, or implicit JSON serialization"
  },
