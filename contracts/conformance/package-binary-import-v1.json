{
  "contract_version": "attolang.package-binary-import.v1",
  "status": "PROPOSED_SOURCE_FREE_REFERENCE_ONLY",
  "source_extension": ".atto",
  "manifest": "existing .atto.pkg.toml and legacy .ores.pkg.toml; precedence requires separate grammar ratification",
  "grammar_proposal": {
    "package_import": "import pkg bar from \"pkg:bar\";",
    "module_import": "import module parser from \"pkg:bar\";",
    "namespace_import": "import namespace network from \"pkg:bar\";",
    "local_file_import": "import module parser from \"./parser.atto\";",
    "canonical_root": "+/",
    "package_alias_uses_lockfile": true
  },
  "invariants": {
    "dependency_identity": "exact locked package instance, not package name or disk path",
    "namespace_identity": "(package_instance_id, flat_namespace_name)",
    "module_identity": "(package_instance_id, module_name)",
    "exports": "qualified-only; public intersection with containing declaration",
    "source_relative": "only inside the verified owning source package; not external binary ABI",
    "compiled_binary": "must carry independently pinned public interface digest and compatible target payload",
    "package_import_no_permissions": true,
    "no_implicit_import_download": true,
    "no_ambient_lock_shadowing": true,
    "no_cross_package_namespace_merge": true
  },
