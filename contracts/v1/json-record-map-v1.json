{
  "version": 1,
  "feature": "json-record-map",
  "library": {
    "public_namespace": "alloc/json",
    "requires_allocator": true,
    "os_capabilities_required": [],
    "core_allowed": false,
    "hosted_std_required": false,
    "core_json_contracts_allowed": true,
    "owned_json_tree_in_core": false,
    "ambient_allocator_allowed": false,
    "allocator_provider": "explicit",
    "core_contract_scope": [
      "token_kinds",
      "borrowed_input_cursor",
      "caller_provided_encode_sink",
      "static_codec_markers"
    ]
  },
  "json_object": {
    "key_type": "String",
    "dynamic_storage": "Map<String, JsonValue>",
    "symbol_key_implicit_coercion": false,
    "duplicate_key_policy": "reject",
    "unknown_typed_field_policy": "reject_by_default"
  },
  "map": {
    "indexed_assignment": "insert_or_replace",
    "named_put_previous_value": "Option<V>",
    "recursive_json_value_descriptor_required": true,
    "host_map_semantics_forbidden": true,
    "indexed_assignment_requires": "direct_owned_mutable_map",
    "indexed_assignment_evaluation": "authority_preflight_then_rhs_once_then_receiver_once_then_key_once",
    "named_put_evaluation": "receiver_and_authority_then_key_once_then_value_once",
    "replacement_atomicity": "validate_and_admit_new_before_publish_then_release_old",
    "move_only_fallible_insert": "runtime_attempt_returns_exact_uncommitted_value_on_rejection_then_compiler_commits_move_only_on_success",
    "owned_put_rejected_candidate": "one_shot_take_before_failure_rethrow",
    "owned_put_previous_value": "one_shot_take_after_commit",
    "compiler_exceptional_flow": "source_moved_on_commit_normal_edge_restored_on_admission_failure_catch_edge",
    "source_move_only_map_visibility": "gated_until_recursive_typechecker_and_alloc_json_import",
    "ownership_checker_staging": "commit_rejection_edges_enabled_in_production_pass",
    "evaluator_owned_put_lowering": "recover_candidate_before_rethrow_take_previous_on_commit",
    "move_only_indexed_assignment_staging": "direct_statement_only_until_linear_assignment_result_defined",
    "move_only_named_put_staging": "direct_statement_or_direct_binding_until_nested_expression_throw_edges",
    "owned_put_guest_visibility": "internal_lowering_only",
    "shared_commit_primitive": "canonical_checked_map_put_path",
    "failed_commit_preserves_previous_mapping": true,
    "failed_commit_must_not_lose_uncommitted_move_value": true,
    "scalar_v1_current_primitive": "OresKeyedMap.put",
    "move_only_internal_primitive": "OresKeyedMap.attemptOwnedPut_linear_one_shot_result"
  },
  "record_update": {
    "syntax": "base with { field: value, ... }",
    "base_kind": "readonly_record_or_plain_struct",
    "static_keys_only": true,
    "duplicate_update_fields": "reject",
    "existing_field": "replace_type_and_value",
    "missing_field": "append_field_and_widen_row",
    "dynamic_key_fallback": "Map",
    "readonly_record_indexed_assignment": "reject",
    "plain_struct_result_kind": "plain_struct",
    "structural_view_update": "reject",
    "evaluation": "base_once_then_updates_left_to_right",
    "failure": "atomic_no_partial_publication",
    "move_only_base": "consume_unless_checked_copy_or_share",
    "result_type_rule": "row_override_existing_then_extend_missing",
    "base_binding_type_mutation": "forbidden",
    "runtime_key_row_change": "forbidden",
    "literal_put_as_row_extension": false
  },
  "typed_codec": {
    "runtime_reflection": false,
    "generation": "compile_time",
    "class_private_field_poke": false,
    "class_opt_in_required": true,
    "direct_typed_decode_may_skip_dom": true,
    "missing_required": "reject",
    "null_required": "reject",
    "option_absent": "None",
    "option_null": "None",
    "field_match": "exact_case_sensitive",
    "rename_collision": "reject",
    "defaults_on_malformed_present_value": false,
    "unknown_capture_type": "Map<String, JsonValue>",
    "known_record_struct_decode": "generated_static_constructor",
    "known_class_decode": "explicit_opt_in_constructor_or_factory",
    "direct_decode_partial_publication": "forbidden"
  },
  "safety": {
    "malformed_utf8": "reject",
    "nan_infinity": "reject",
    "integer_precision_loss": "reject",
    "explicit_resource_quotas_required": true,
    "guest_callbacks_under_internal_lock": false,
    "unpaired_surrogate_escape": "reject",
    "unescaped_control_character": "reject",
    "bom_default": "reject",
    "comments_default": "reject",
    "trailing_comma_default": "reject",
    "ignored_unknown_fields_count_toward_quotas": true,
    "mutable_json_cycle_invariant": "edge_creation_serialized_and_cycle_checked",
    "graph_stability_mutations": "all_json_object_mutations_share_global_guard_before_object_monitor",
    "whole_tree_quota_boundary": "revalidate_depth_and_nodes_under_graph_stability_guard_before_recursive_externalization"
  },
  "json_number": {
    "representation": "exact_before_target_conversion",
    "integer_over_2_pow_53": "preserve",
    "non_finite": "reject",
    "float_overflow": "reject_by_default",
    "integer_target_acceptance": "mathematically_integral_in_range_including_decimal_or_exponent_spelling"
  },
  "encoding": {
    "ordinary_json_cycle": "reject",
    "implicit_runtime_capabilities": "reject",
    "deterministic_for_fixed_value": true,
    "cryptographic_canonicalization": "separate_profile"
  }
}
