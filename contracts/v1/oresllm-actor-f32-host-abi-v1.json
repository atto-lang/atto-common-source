{
  "contract": "attolang.oresllm.actor-f32-host-bridge",
  "version": 1,
  "status": "DESIGN_AND_PREFLIGHT_ONLY",
  "canonical_source_organization": "ores-truffle-oreslang",
  "name": "Actor-bound bounded f32 GEMM host ABI",
  "scope": {
    "operations": [
      "f32_pool_acquire",
      "f32_pool_begin",
      "f32_pool_read",
      "f32_pool_write",
      "f32_gemm",
      "f32_pool_retire",
      "f32_pool_release"
    ],
    "origin": "trusted scheduler dispatch, not guest-authored actor/tenant integers",
    "target_backends": [
      "java-graal",
      "llvm"
    ],
    "native_implementation": "ores-llm/ores-llm-ml-kernels-cpu.atto#29 (production C11 HOST ONLY)",
    "tensor_provider": "ores-llm/ores-llm-tensor.atto#37 (production C11 HOST ONLY)"
  },
  "limits": {
    "max_axis": 32,
    "max_output_bytes": 4096,
    "bytes_per_f32": 4,
    "pool_slots": 16,
    "inputs_min": -256,
    "inputs_max": 256
  },
  "caller": {
    "required_context_fields": [
      "runtime_domain",
      "execution_id",
      "allocation_kind",
      "allocation_domain",
      "actor_owner",
      "actor_generation",
      "physical_turn_claim"
    ],
    "allocation_kind": "ACTOR",
    "all_fields_host_supplied": true,
    "guest_controls_authority_fields": false,
    "backend_validator": "live physically owned RUNNING actor turn",
    "requires_revocation_and_restart_fence": true,
    "new_operations_after_stop": "DENY",
    "cancellation": "no early physical-memory release until in-flight call/turn quiesces"
  },
  "tensors": {
    "representation": "host-private broker pointer plus generation-fenced, nonbearer pool reference",
    "guest_native_pointer_exposure": false,
    "shape": "exact live row/column dimensions, not a guest assertion",
    "lifetime": "inputs borrowed for full operation; result exclusively owned until release",
    "failure": "do not modify caller output handle; rollback unpublished output and physical reservation exactly once",
    "ownership_compiler_requirements": [
      "reject_use_after_take",
      "reject_mutable_alias",
      "reject_borrow_across_suspend_unpinned",
      "reject_stale_or_foreign_actor_domain",
      "drop_on_exception_and_cancellation"
    ]
  },
  "abi_candidate": {
    "symbol": "ores_f32_guest_gemm_v1",
    "binding_kind": "TRUSTED_RUNTIME_INTERNAL_ONLY",
    "parameters": [
      "host_owned_context",
      "host_owned_tensor_broker",
      "lhs_opaque_ref",
      "lhs_generation",
      "lhs_rows",
      "lhs_cols",
      "rhs_opaque_ref",
      "rhs_generation",
      "rhs_rows",
      "rhs_cols",
      "max_output_bytes",
      "out_ref",
      "out_generation"
    ],
    "expose_to_guest": "NEVER",
    "direct_ffi_compiler_lowering": "NOT_IMPLEMENTED",
    "source_typechecker_intrinsic": "NOT_IMPLEMENTED",
    "statuses": [
      "DENIED",
      "INVALID_SHAPE",
      "QUOTA",
      "STALE",
      "PROVIDER_FAULT",
      "BACKEND_UNAVAILABLE",
      "OK_ONLY_AFTER_REAL_EXECUTION"
    ]
  },
  "witnesses": {
    "java": "ExecutionContext allocation-kind ACTOR + scheduler physical turn guard; admission candidate only, no Java Native Image FFI",
    "llvm": "OresNativeExecutionContext + ores_execution_owns_running on supervisor authority, admission candidate only",
    "shared_candidate": "host-only admission is not evidence of full compiler lowering"
  },
  "negative_cases": [
    "no_turn",
    "foreign_thread_copied_claim",
    "stopping_actor",
    "restarted_generation",
    "foreign_actor_scope",
    "invalid_shape",
    "output_quota",
    "stale_tensor_generation",
    "forged_pool_ref",
    "use_after_take",
    "loan_across_await"
  ],
  "release_gates": [
    "exact_source_head_host_native_matrix",
    "executed_compiler_guest_java",
    "executed_compiler_guest_llvm",
    "executed_graalvm_native_image",
    "executed_llvm_aot",
    "ownership_compile_negative",
    "actor_derived_runtime_authority",
    "no_cross_org_private_compiler_source_without_approval"
  ],
  "security_incident": "ores-llm/ores-llm-ml-conformance-tests#29",
  "certification": {
    "compiler_emitted_guest": "NOT_EXECUTED",
    "java_aot": "NOT_EXECUTED",
    "llvm_aot": "NOT_EXECUTED",
    "tenant_isolation": "NOT_CERTIFIED",
    "release_ready": false
  }
}
