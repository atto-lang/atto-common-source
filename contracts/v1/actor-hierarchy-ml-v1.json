{
  "schema": "oreslang.actor-hierarchy-ml.v1",
  "status": "CONTRACT_ONLY_NOT_GUEST_EXECUTED",
  "actor_root": "Actor",
  "default_domain": "shared",
  "roots": [
    "Actor",
    "IsoActor",
    "UntrustedActor"
  ],
  "hierarchy": {
    "max_concrete_parents": 1,
    "single_effective_state_schema": true,
    "trait_instance_fields": false,
    "interface_instance_fields": false,
    "share_requires": [
      "Send",
      "Sync"
    ],
    "public_actor_protocol": "runtime_mailbox_only",
    "actor_ref_narrowing": "verified_nominal_interface_only",
    "supervisor_control": "runtime_private",
    "runtime_reserved_prefix": "__runtime_"
  },
  "ml": {
    "stage_placement": "coarse_actor_per_stage_or_shard",
    "default_schedule": "fill_drain",
    "backward_key": [
      "run",
      "incarnation",
      "graph_generation",
      "step",
      "microbatch",
      "weight_version",
      "edge",
      "activation_ticket"
    ],
    "all_expected_edges_required": true,
    "weights_and_optimizer_publish_together": true,
    "max_inflight_contexts": 2,
    "initial_weight": 5,
    "initial_weight_version": 3,
    "learning_rate": 0.1,
    "planned_microbatches": 2,
    "expected_edges": [
      "left",
      "right"
    ],
    "allow_replay": false,
    "required_evidence": "REAL_EXECUTED_GUEST_EXACT_HEAD"
  },
  "backends": [
    {
      "name": "java",
      "guest_execution": "NOT_EXECUTED",
      "outcome": "NOT_CLAIMED"
    },
    {
      "name": "llvm",
      "guest_execution": "NOT_EXECUTED",
      "outcome": "NOT_CLAIMED"
    },
    {
      "name": "wasm",
