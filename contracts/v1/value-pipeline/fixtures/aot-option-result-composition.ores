fnc double(int n): int { return n * 2; }
fnc improve(String s): String { return s + "!"; }
pub fnc main(): int {
  val int a = Some(2) |> Option.map(double) |> Option.unwrap_or(0);
  val int b = Ok(3) |> Result.map(double) |> Result.unwrap_or(0);
  val Result<int, String> failure = Err("bad") |> Result.map_err(improve);
  val int c = failure |> Result.unwrap_or(1);
  return a + b + c;
}
