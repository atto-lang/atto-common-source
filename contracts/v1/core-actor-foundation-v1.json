      "stage": "existing_language_intrinsic",
      "runtime_owned": true,
      "control_access": false,
      "guest_defined_privilege": false,
      "implementation": "native_atto_or_compiler_intrinsic",
      "control_authority": "none",
      "private_control_ingress": false
    },
    {
      "name": "SupervisorActor",
      "role": "runtime-validated supervisor; CONTROL callbacks never ordinary callable methods",
      "stage": "proposed_checked_base",
      "runtime_owned": true,
      "control_access": true,
      "guest_defined_privilege": false,
      "implementation": "native_atto_or_compiler_intrinsic",
