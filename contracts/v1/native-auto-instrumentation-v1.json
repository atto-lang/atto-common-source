  ],
  "evidence": {
    "self_test_scope": "contract_shape_only",
    "source_only_is_backend_execution": false,
    "requires_guest_compiler": true,
    "requires_actual_backend_artifact": true,
    "requires_stepful_execution": true,
    "requires_exact_sha": true,
    "required_results": [
      "source_contract",
      "compiler_lowering",
      "executed_guest",
      "aot_artifact",
      "privacy_and_pressure",
      "performance"
    ],
    "backend_execution_status": {
      "java": "NOT_EXECUTED",
      "llvm": "NOT_EXECUTED",
      "wasm": "NOT_EXECUTED",
      "forge": "NOT_EXECUTED",
      "net": "NOT_EXECUTED"
    }
  },
  "architecture_v1_reconciliation": {
    "target_public_core": "ores.core.trace",
    "target_public_std": "ores.std.telemetry",
    "public_grammar": "no_new_keyword_required",
    "producers": [
      "typed_compiler_mir",
      "trusted_actor_scheduler_runtime",
      "registered_native_atto_stdlib"
    ],
    "common_abi": "versioned_fixed_id_typed_nonthrowing_nonsuspending",
    "semantic_probe_deduplication": true,
    "scope_terminal_paths": [
      "return",
      "question_early_exit",
      "trap",
      "throw",
      "raise",
      "panic",
      "cancel",
      "preempt",
      "unwind"
    ],
    "scope_reclamation": "exactly_once_with_generation_fence",
    "descriptor_id": "stable_for_identical_artifact_input",
    "context_storage": "immutable_envelope_and_continuation_not_tls_or_guest_payload",
    "non_recording_context_propagates": true,
    "recording_and_sampled_distinct": true,
    "sampling": "otel_parentbased_root_sampler_and_local_rate_cap",
    "untrusted_remote_sampled_flag_is_not_permission": true,
    "propagation_separate_from_recording": true,
    "no_new_trace_headers_when_default_off": true,
    "tracing_off_does_not_implicitly_disable_explicit_propagators": true,
    "no_implicit_default_exporter": true,
    "no_default_new_io_permissions": true,
    "std_implementation_language": ".atto_when_expressible",
    "producer_and_exporter_recursion_prevented": true,
    "collector_transport": "nonblocking_bounded_async_actor",
    "strict_io": "fail_closed_if_no_nonblocking_provider",
    "otlp_initial_protocol": "http/protobuf",
    "hard_real_time": "compile_none_or_prove_bounded_probes",
    "excludes_automatic_native_ffi_introspection": true
  },
  "otel_environment": {
    "variables": [
      "OTEL_SERVICE_NAME",
      "OTEL_RESOURCE_ATTRIBUTES",
      "OTEL_SDK_DISABLED",
      "OTEL_TRACES_SAMPLER",
      "OTEL_TRACES_SAMPLER_ARG",
      "OTEL_PROPAGATORS",
      "OTEL_TRACES_EXPORTER",
      "OTEL_EXPORTER_OTLP_ENDPOINT",
      "OTEL_EXPORTER_OTLP_PROTOCOL"
    ],
    "semantics": "compatible_with_otel_sdk_environment_spec_when_supported",
    "interpret_once_per_runtime_start": true,
    "precedence": [
      "capability_denial",
      "sdk_disabled_for_recording_export_only",
      "explicit_atto_cli",
      "otel_sdk_environment_for_enabled_sdk",
      "atto_package_defaults"
    ],
