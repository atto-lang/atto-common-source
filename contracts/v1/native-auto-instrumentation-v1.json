    {
      "id": 50,
      "name": "db.execute",
      "kind": "boundary",
      "profile": "boundaries"
    },
    {
      "id": 60,
      "name": "collector.drop",
      "kind": "internal",
      "profile": "boundaries"
    },
    {
      "id": 14,
      "name": "channel.send",
      "kind": "boundary",
      "profile": "boundaries"
    },
    {
      "id": 15,
      "name": "channel.receive",
