    {
      "id": "jit-none-no-metadata",
      "build": "none",
      "runtime": "on",
      "operation": "strict_stripped_no_ast_tags_ir_or_dynamic_runtime",
      "expect": {
        "static_probe_sites": 0,
        "dynamic_jit_probes": 0,
        "activation_result": "instrumentation_unavailable",
        "guest_effects": "unchanged"
