    {
      "id": "using-early-return",
      "build": "functions",
      "runtime": "on",
      "operation": "using-early-return",
      "expect": {
        "close_scope_calls": 1,
        "guest_return_unchanged": true
      }
    },
    {
      "id": "using-exception-and-cancel",
      "build": "functions",
      "runtime": "on",
      "operation": "using-exception-and-cancel",
      "expect": {
        "cleanup_on": [
          "throw",
          "raise",
          "panic",
          "cancel"
        ],
        "close_scope_calls_per_activated_scope": 1,
        "supervisor_control_unmodified": true
      }
    },
    {
      "id": "using-await-survival",
      "build": "functions",
      "runtime": "on",
      "operation": "using-await-survival",
      "expect": {
        "close_on_suspend": false,
        "close_on_lexical_exit": true,
        "span_context_preserved": true
      }
    },
    {
      "id": "using-scope-borrow-escape",
      "build": "functions",
      "runtime": "on",
      "operation": "using-scope-borrow-escape",
      "expect": {
        "scope_token_escape_rejected": true,
        "actor_transfer_rejected": true,
        "non_scoped_resource_rejected": true
      }
    },
    {
      "id": "using-no-op-disabled",
      "build": "functions",
      "runtime": "off",
      "operation": "using-no-op-disabled",
      "expect": {
        "recorded_spans": 0,
        "clock_reads": 0,
        "resource_scope_valid": true,
        "user_argument_side_effects_preserved": true
      }
    },
    {
      "id": "jit-live-attach",
      "build": "functions",
      "runtime": "on",
      "operation": "jit-live-attach",
      "expect": {
        "same_process": true,
        "requires_instrumentable_nodes": true,
        "attached_truffle_probes": true,
        "deopt_and_recompile": true,
        "subsequent_calls_recorded": true
      }
    },
    {
      "id": "jit-live-detach",
      "build": "functions",
      "runtime": "on",
      "operation": "jit-live-detach",
      "expect": {
        "same_process": true,
        "probes_removed_from_future_entries": true,
        "already_started_scopes_finalized_per_policy": true
      }
    },
    {
      "id": "jit-security-denial",
      "build": "functions",
      "runtime": "on",
      "operation": "jit-security-denial",
      "expect": {
        "unauthorized_request_denied": true,
        "no_execution_mutation": true,
        "no_extra_egress_permission": true
