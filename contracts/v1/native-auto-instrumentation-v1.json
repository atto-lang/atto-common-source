{
  "schema": "atto-native-auto-instrumentation.v1",
  "status": "PROPOSAL_SOURCE_ONLY_NOT_EXECUTED",
  "reference_date": "2026-11-12",
  "supported_target_backends": [
    "java",
    "llvm",
    "wasm",
    "forge",
    "net"
  ],
  "invariants": {
    "monkey_patching": false,
    "dynamic_code_generation": false,
    "runtime_default": "off",
    "build_default": "boundaries",
    "core_diagnostics_independent": true,
    "otel_userland_import_implicit": false,
    "std_exporter_requires_host_opt_in": true,
    "trace_context_location": "immutable_actor_envelope_and_continuation",
    "no_thread_local_context_assumption": true,
    "no_synchronous_exporter": true,
    "queue_memory_bounded": true,
    "saturation_behavior": "drop_and_count",
    "core_can_depend_on_std": false,
    "guest_semantics_unchanged_on_export_failure": true,
    "function_instrumentation_opt_in": true,
    "trace_id_bits": 128,
    "span_id_bits": 64
  },
  "build_modes": [
    "none",
    "boundaries",
    "functions"
  ],
  "runtime_modes": [
    "off",
    "on"
  ],
  "exporter_modes": [
    "none",
    "otlp",
    "file"
  ],
  "defaults": {
    "build": "boundaries",
    "runtime": "off",
    "exporter": "none",
    "buffer_events": 8192,
    "capture_request_bodies": false,
    "capture_arbitrary_headers": false,
    "capture_sql_bindings": false,
    "capture_guest_objects": false,
    "propagation": "off",
    "capture_trace_baggage": false,
    "capture_file_paths": false,
    "probe_self_exclusion": [
      "collector_actor",
      "otlp_exporter_actor",
      "raw_export_transport",
      "sampling_clock",
      "trace_allocator"
    ]
  },
  "hooks": [
    {
      "id": 1,
      "name": "fn.enter",
      "kind": "compiler",
      "profile": "functions"
    },
    {
      "id": 2,
      "name": "fn.exit",
      "kind": "compiler",
      "profile": "functions"
    },
    {
