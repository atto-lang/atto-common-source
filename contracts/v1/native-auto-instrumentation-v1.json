      "kind": "boundary",
      "profile": "boundaries"
    },
    {
      "id": 12,
      "name": "http.client.attempt",
      "kind": "boundary",
      "profile": "boundaries"
    },
    {
      "id": 13,
      "name": "http.client.finish",
      "kind": "boundary",
      "profile": "boundaries"
    },
    {
      "id": 20,
      "name": "actor.send",
      "kind": "boundary",
      "profile": "boundaries"
    },
    {
      "id": 21,
      "name": "actor.admit",
      "kind": "boundary",
      "profile": "boundaries"
    },
    {
      "id": 22,
      "name": "actor.process",
      "kind": "boundary",
      "profile": "boundaries"
    },
    {
      "id": 30,
      "name": "continuation.suspend",
      "kind": "compiler",
      "profile": "boundaries"
    },
    {
      "id": 31,
      "name": "continuation.resume",
      "kind": "compiler",
      "profile": "boundaries"
    },
    {
      "id": 40,
      "name": "io.complete",
      "kind": "boundary",
