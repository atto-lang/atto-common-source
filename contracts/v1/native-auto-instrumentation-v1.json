      "id": "aot-instrument-boundaries",
      "build": "functions",
      "runtime": "on",
      "operation": "aot-instrument-boundaries",
      "expect": {
        "runtime_enable_without_jit": true,
        "semantic_boundary_probe_records": true,
        "manual_using_supported": true
