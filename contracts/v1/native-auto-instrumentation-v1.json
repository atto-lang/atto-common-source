      "id": "truffle-source-mapping",
      "build": "functions",
      "runtime": "on",
      "operation": "truffle-source-mapping",
      "expect": {
        "source_tags_retained": true,
        "deterministic_descriptor_ids": true,
        "no_opaque_binary_guessing": true
