    {
      "id": "jit-bounded-churn",
      "build": "functions",
      "runtime": "on",
      "operation": "jit-bounded-churn",
      "expect": {
        "trace_filter_bounded": true,
        "compile_work_bounded": true,
        "supervisor_control_unblocked": true
      }
