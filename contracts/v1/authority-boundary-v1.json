{
  "schema": "oreslang.authority-boundary.v1",
  "evidence": "SOURCE_FREE_ORACLE_ONLY",
  "description": "Reference admission model; does not execute Oreslang source, enforce host sandboxing, or establish compiler parity.",
  "target_backends": [
    "java",
    "llvm",
    "wasm",
    "net",
    "js"
  ],
  "rules": {
    "unknown": "opaque untrusted input; explicit type validation required before any narrowing",
    "any": "typed opaque safe scalar in v1; cannot erase actor, borrow, function, or mutable authority",
    "message": "only validated, independently copyable scalar values in this conservative oracle; opaque any/unknown never cross",
    "permissions": "process policy ceilings, parent-child delegation only, effects declaration is not a capability grant",
    "critical": "state loans forbid boundary crossing and effectful I/O until returned",
    "upgrade": "no cap escalation, generation invalidation, quiescence check, schema compatibility, children coordinated separately",
    "unsupported": "fail closed"
  },
  "cases": [
    {
      "id": "scalar-int",
      "expect": "allow"
    },
    {
      "id": "scalar-bool",
      "expect": "allow"
    },
    {
