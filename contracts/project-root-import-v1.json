{
  "scenario": "deeply nested REST handler and root-local modules",
  "manifest": ".ores.pkg.toml",
  "legacy_manifest": ".oreslangc.cfg.toml",
  "project_root": ".",
  "importer": "src/routes/rest/foo/bar/baz/delete.ores",
  "files": [
    "lib/store.ores",
    "lib/telemetry.ores",
    "lib/transport.java",
    "src/lib/store.ores",
    "src/routes/rest/foo/bar/baz/local.ores",
    "src/routes/rest/foo/bar/up.ores",
    "src/.hidden/helper.ores",
    "src/..backup/helper.ores"
  ],
  "resolution_cases": [
    {
      "id": "root-store",
      "specifier": "+/lib/store",
      "expect": "lib/store.ores"
    },
    {
      "id": "root-telemetry",
      "specifier": "+/lib/telemetry",
      "expect": "lib/telemetry.ores"
    },
    {
      "id": "source-path-explicit",
      "specifier": "+/src/lib/store",
      "expect": "src/lib/store.ores"
    },
    {
      "id": "java-fallback",
      "specifier": "+/lib/transport",
      "expect": "lib/transport.java"
    },
    {
      "id": "exact-file",
      "specifier": "+/lib/store.ores",
      "expect": "lib/store.ores"
    },
    {
      "id": "local-relative-unchanged",
      "specifier": "./local",
      "expect": "src/routes/rest/foo/bar/baz/local.ores"
    }
  ],
  "rejection_cases": [
    {
      "id": "missing-module-no-vendor-fallback",
      "specifier": "+/vendor/missing",
      "error": "not-found"
    },
    {
      "id": "missing-manifest",
      "specifier": "+/lib/store",
      "error": "manifest-required",
      "without_manifest": true
    },
    {
      "id": "bare-plus",
      "specifier": "+",
      "error": "invalid-prefix"
    },
    {
      "id": "no-slash",
      "specifier": "+lib/store",
      "error": "invalid-prefix"
    },
    {
      "id": "empty-suffix",
      "specifier": "+/",
      "error": "invalid-segment"
    },
    {
      "id": "double-slash",
      "specifier": "+//lib/store",
      "error": "invalid-segment"
    },
    {
      "id": "trailing-slash",
      "specifier": "+/lib/",
      "error": "invalid-segment"
    },
    {
      "id": "dot-segment",
      "specifier": "+/./lib/store",
      "error": "invalid-segment"
    },
    {
      "id": "parent-escape",
      "specifier": "+/../outside",
      "error": "invalid-segment"
    },
    {
      "id": "parent-normalized-inside",
      "specifier": "+/lib/../store",
      "error": "invalid-segment"
    },
    {
      "id": "backslash-prefix",
      "specifier": "+\\\\lib\\\\store",
      "error": "invalid-separator"
    },
    {
      "id": "backslash-within",
      "specifier": "+/lib\\\\store",
      "error": "invalid-separator"
    }
  ],
  "additional_required_cases": [
    "symlink-escape-rejected",
    "nearest-manifest-selection",
    "modern-manifest-same-dir-wins",
    "explicit-root-override",
    "explicit-override-requires-manifest",
    "cwd-independent-link-identity",
    "run-check-aot-equivalence",
    "configured-project-root-subdirectory",
    "explicit-relative-versus-dot-bare",
    "source-roots-explicit-empty",
    "ores-paths-search-precedence",
    "nested-modern-and-legacy-package-boundary",
    "nested-package-symlink-alias-denied",
    "malformed-manifest-marker-fail-closed-before-fallback",
    "nearest-vs-ancestor-manifest-precedence",
    "nested-package-boundary-for-bare-and-relative-imports",
    "physical-source-root-symlink-escape-denial",
    "modern-configured-root-physical-containment",
    "strict-manifest-known-field-types",
    "dangling-nested-manifest-marker-rejection",
    "strict-crlf-or-lf-modern-manifest-lines"
  ],
  "implementation_status_at_creation": {
    "java": "draft-pr-pending-CI",
    "llvm": "unsupported-source-import-linking",
    "net": "unsupported-source-import-linking",
    "forge": "unsupported-source-import-linking",
    "wasm": "delegated-to-real-source-compiler"
  },
  "contract_version": "oreslang.project-root-imports.v1",
  "namespace_boundary_cases": [
    {
      "id": "parent-child-direct-denied",
      "importer_package": "parent",
      "specifier": "+/nested/lib/child",
      "spelled_path": "parent/nested/lib/child.ores",
      "physical_target": "parent/nested/lib/child.ores",
      "expect": "reject-nested-package"
    },
    {
      "id": "parent-child-symlink-back-denied",
      "importer_package": "parent",
      "specifier": "+/nested/parent-alias",
      "spelled_path": "parent/nested/parent-alias.ores",
      "physical_target": "parent/lib/helper.ores",
      "expect": "reject-nested-package"
    },
    {
      "id": "parent-symlink-in-root-allowed",
      "importer_package": "parent",
      "specifier": "+/lib/alias",
      "spelled_path": "parent/lib/alias.ores",
      "physical_target": "parent/lib/helper.ores",
      "expect": "resolve-parent-lib-helper"
    },
    {
      "id": "child-own-root-allowed",
      "importer_package": "nested",
      "specifier": "+/lib/child",
      "spelled_path": "parent/nested/lib/child.ores",
      "physical_target": "parent/nested/lib/child.ores",
      "expect": "resolve-child-lib-child"
    },
    {
      "id": "parent-child-dangling-manifest-denied",
      "importer_package": "parent",
      "specifier": "+/dangling/lib/child",
      "spelled_path": "parent/dangling/lib/child.ores",
      "physical_target": "parent/dangling/lib/child.ores",
      "expect": "reject-invalid-nested-marker"
    }
  ],
  "promotion_gates": {
    "safe_admission": "Negative source checks alone must never imply resolver/link/runtime parity",
    "resolver": "Each supported import must resolve to the same pinned physical source identity and package context",
    "execution": "Backend compiler must compile, link and execute the same multi-source fixture with correct result",
    "provenance": "Executed non-skipped CI job must pin exact head, source blobs, fixture blobs and compiler/runtime identity",
    "wasm": "Wasm output additionally requires a complete verified LLVM source graph and real wasm32 guest artifact"
  },
  "open_decisions": [
    {
      "id": "root-anchor-vs-project-root",
      "question": "Does +/ bind to the physical directory containing the nearest .ores.pkg.toml or to [project].root from that manifest?",
      "needs_alignment": [
        "oreslang-platform-conformance#39",
        "oreslang-source.java#1050",
        "oreslang-source.llvm#448",
        "oreslang-common-source#51"
      ],
      "normative_resolution": "The selected manifest directory anchors [project].root; +/ uses that configured project root.",
      "status": "backend-alignment-pending"
    }
  ],
  "relative_source_cases": [
    {
      "id": "explicit-sibling-relative",
      "importer": "src/routes/rest/foo/bar/baz/delete.ores",
      "specifier": "./local",
      "namespace": "relative",
      "expect": "src/routes/rest/foo/bar/baz/local.ores"
    },
    {
      "id": "explicit-parent-relative",
      "importer": "src/routes/rest/foo/bar/baz/delete.ores",
      "specifier": "../up",
      "namespace": "relative",
      "expect": "src/routes/rest/foo/bar/up.ores"
    },
    {
      "id": "dot-prefixed-bare-not-relative",
      "importer": "src/routes/rest/foo/bar/baz/delete.ores",
      "specifier": ".hidden/helper",
      "namespace": "bare",
      "source_root": "src",
      "expect": "src/.hidden/helper.ores"
    },
    {
      "id": "double-dot-prefixed-bare-not-relative",
      "importer": "src/routes/rest/foo/bar/baz/delete.ores",
      "specifier": "..backup/helper",
      "namespace": "bare",
      "source_root": "src",
      "expect": "src/..backup/helper.ores"
    }
  ],
  "namespace_parity_cases": [
    {
      "id": "project-root-field-subdir",
      "manifest_project_root": "app",
      "specifier": "+/src/helper",
      "file": "app/src/helper.ores",
      "expect": "app/src/helper.ores",
      "goal": "resolve-link-execute"
    },
    {
      "id": "project-root-field-manifest-sibling-denied",
      "manifest_project_root": "app",
      "specifier": "+/outside",
      "file": "outside.ores",
      "error": "not-found",
      "goal": "reject-before-link"
    },
    {
      "id": "importer-relative-dot-slash",
      "specifier": "./local",
      "importer": "src/routes/rest/foo/bar/baz/delete.ores",
      "file": "src/routes/rest/foo/bar/baz/local.ores",
      "expect": "src/routes/rest/foo/bar/baz/local.ores"
    },
    {
      "id": "importer-relative-parent",
      "specifier": "../up",
      "importer": "src/routes/rest/foo/bar/baz/delete.ores",
      "file": "src/routes/rest/foo/bar/up.ores",
      "expect": "src/routes/rest/foo/bar/up.ores"
    },
    {
      "id": "dot-prefixed-bare-search",
      "specifier": ".hidden/helper",
      "importer": "src/routes/rest/foo/bar/baz/delete.ores",
      "source_roots": [
        "src"
      ],
      "file": "src/.hidden/helper.ores",
      "expect": "src/.hidden/helper.ores"
    },
    {
      "id": "environment-precedence",
      "specifier": "priority",
      "source_roots": [
        "src"
      ],
      "source_import_paths": [
        "vendor"
      ],
      "ores_paths": [
        "env"
      ],
      "oreslang_path": [
        "legacy"
      ],
      "files": [
        "src/priority.ores",
        "vendor/priority.ores",
        "env/priority.ores",
        "legacy/priority.ores"
      ],
      "expect_order": [
        "src/priority.ores",
        "vendor/priority.ores",
        "env/priority.ores",
        "legacy/priority.ores"
      ]
    },
    {
      "id": "explicit-empty-roots",
      "specifier": "only-here",
      "source_roots": [],
      "source_import_paths": [],
      "file": "only-here.ores",
      "error": "not-found",
      "goal": "deny-implicit-root"
    },
    {
      "id": "empty-ores-paths-component",
      "specifier": "only-here",
      "ores_paths": [
        "",
        "env",
        ""
      ],
      "error": "empty-component-must-not-grant-cwd"
    },
    {
      "id": "nested-modern-package",
      "specifier": "+/child/secret",
      "nested_manifest": "child/.ores.pkg.toml",
      "file": "child/secret.ores",
      "error": "nested-package-boundary"
    },
    {
      "id": "nested-legacy-package",
      "specifier": "+/child/secret",
      "nested_manifest": "child/.oreslangc.cfg.toml",
      "file": "child/secret.ores",
      "error": "nested-package-boundary"
    },
    {
      "id": "nested-package-symlink-alias",
      "specifier": "+/alias",
      "symlink_alias_to": "child/secret.ores",
      "nested_manifest": "child/.ores.pkg.toml",
      "error": "nested-package-boundary"
    },
    {
      "id": "source-physical-identity",
      "specifier": "+/alias",
      "symlink_alias_to": "lib/helper.ores",
      "file": "lib/helper.ores",
      "expect": "canonical-physical-identity"
    },
    {
      "id": "modern-directory-marker-shadows-valid-legacy",
      "manifest": ".ores.pkg.toml",
      "marker_kind": "directory",
      "legacy_manifest": ".oreslangc.cfg.toml",
      "legacy_valid": true,
      "error": "invalid-modern-marker",
      "goal": "reject-before-authority-selection"
    },
    {
      "id": "modern-dangling-symlink-shadows-valid-legacy",
      "manifest": ".ores.pkg.toml",
      "marker_kind": "dangling-symlink",
      "legacy_manifest": ".oreslangc.cfg.toml",
      "legacy_valid": true,
      "error": "invalid-modern-marker",
      "goal": "reject-before-authority-selection"
    },
    {
      "id": "modern-inside-root-symlink-shadows-valid-legacy",
      "manifest": ".ores.pkg.toml",
      "marker_kind": "symlink-to-in-root-legacy",
      "legacy_manifest": ".oreslangc.cfg.toml",
      "legacy_valid": true,
      "error": "invalid-modern-marker",
      "goal": "reject-before-authority-selection"
    },
    {
      "id": "malformed-legacy-marker-not-manifestless",
      "manifest": ".oreslangc.cfg.toml",
      "marker_kind": "directory",
      "modern_manifest_absent": true,
      "error": "invalid-legacy-marker",
      "goal": "reject-before-manifestless-fallback"
    },
    {
      "id": "nearest-legacy-before-ancestor-modern",
      "importer": "app/child/src/main.ores",
      "manifests": [
        "app/.ores.pkg.toml",
        "app/child/.oreslangc.cfg.toml"
      ],
      "expect_manifest": "app/child/.oreslangc.cfg.toml",
      "goal": "nearest-package-owns-imports"
    },
    {
      "id": "modern-priority-only-at-same-directory",
      "importer": "app/child/src/main.ores",
      "manifests": [
        "app/.ores.pkg.toml",
        "app/child/.ores.pkg.toml",
        "app/child/.oreslangc.cfg.toml"
      ],
      "expect_manifest": "app/child/.ores.pkg.toml",
      "goal": "same-directory-modern-priority"
    },
    {
      "id": "nearer-invalid-legacy-denies-ancestor-modern",
      "importer": "app/child/src/main.ores",
      "manifests": [
        "app/.ores.pkg.toml"
      ],
      "invalid_marker": "app/child/.oreslangc.cfg.toml",
      "marker_kind": "directory",
      "error": "invalid-nearest-manifest",
      "goal": "deny-fallback"
    },
    {
      "id": "bare-import-denied-into-nested-modern-package",
      "importer": "src/routes/main.ores",
      "source_roots": [
        "src"
      ],
      "specifier": "child/secret",
      "nested_manifest": "src/child/.ores.pkg.toml",
      "file": "src/child/secret.ores",
      "error": "nested-package-boundary",
      "goal": "deny-before-link"
    },
    {
      "id": "relative-import-denied-into-nested-legacy-package",
      "importer": "src/routes/main.ores",
      "specifier": "./child/secret",
      "nested_manifest": "src/routes/child/.oreslangc.cfg.toml",
      "file": "src/routes/child/secret.ores",
      "error": "nested-package-boundary",
      "goal": "deny-before-link"
    },
    {
      "id": "bare-import-symlink-escape-denied",
      "importer": "src/main.ores",
      "source_roots": [
        "src"
      ],
      "specifier": "secret",
      "symlink_alias_to": "../outside/secret.ores",
      "error": "physical-project-root-escape",
      "goal": "deny-before-link"
    },
    {
      "id": "modern-project-root-absolute-denied",
      "manifest": ".ores.pkg.toml",
      "project_root": "/other/location",
      "error": "invalid-modern-root",
      "goal": "deny-before-loading-source"
    },
    {
      "id": "modern-project-root-traversal-denied",
      "manifest": ".ores.pkg.toml",
      "project_root": "../sibling",
      "error": "invalid-modern-root",
      "goal": "deny-before-loading-source"
    },
    {
      "id": "modern-project-root-noncanonical-denied",
      "manifest": ".ores.pkg.toml",
      "project_root": "app/./lib",
      "error": "invalid-modern-root",
      "goal": "deny-before-loading-source"
    },
    {
      "id": "modern-project-root-nested-legacy-denied",
      "manifest": ".ores.pkg.toml",
      "project_root": "app/child",
      "nested_manifest": "app/child/.oreslangc.cfg.toml",
      "error": "nested-package-boundary",
      "goal": "deny-before-loading-source"
    },
    {
      "id": "modern-project-root-outside-symlink-denied",
      "manifest": ".ores.pkg.toml",
      "project_root": "app-link",
      "symlink_alias_to": "../external-project",
      "error": "physical-package-root-escape",
      "goal": "deny-before-loading-source"
    },
    {
      "id": "modern-project-root-wrong-toml-type-denied",
      "manifest": ".ores.pkg.toml",
      "project_root": 17,
      "error": "manifest-known-field-type",
      "goal": "deny-before-loading-source"
    },
    {
      "id": "nested-legacy-dangling-marker-denied",
      "specifier": "./child/secret",
      "importer": "src/routes/main.ores",
      "nested_manifest": "src/routes/child/.oreslangc.cfg.toml",
      "marker_kind": "dangling-symlink",
      "file": "src/routes/child/secret.ores",
      "error": "nested-package-boundary",
      "goal": "deny-before-link"
    },
    {
      "id": "modern-manifest-bare-cr-hidden-root-denied",
      "manifest": ".ores.pkg.toml",
      "manifest_contents": "schema_version = \"1\" # visible comment\r[project]\rroot = \"../outside\"\n",
      "marker_kind": "regular-file",
      "error": "invalid-modern-manifest-line-ending",
      "goal": "reject-before-source-resolution"
    },
    {
      "id": "modern-manifest-bare-cr-at-eof-denied",
      "manifest": ".ores.pkg.toml",
      "manifest_contents": "schema_version = \"1\"\r",
      "error": "invalid-modern-manifest-line-ending",
      "goal": "reject-before-source-resolution"
    },
    {
      "id": "modern-manifest-crlf-project-root-accepted",
      "manifest": ".ores.pkg.toml",
      "manifest_contents": "schema_version = \"1\"\r\n[project]\r\nroot = \"app\"\r\n",
      "manifest_project_root": "app",
      "specifier": "+/src/helper",
      "file": "app/src/helper.ores",
      "expect": "app/src/helper.ores",
      "goal": "resolve-only-until-linked-proven"
    }
  ],
  "parity_evidence_requirements": {
    "status_values": [
      "unsupported",
      "admission-only",
      "resolver-only",
      "linked",
      "executed"
    ],
    "native_execution_requires": [
      "exact-candidate-git-tree",
      "native-compiler-build",
      "verified-resolved-source-graph",
      "actual-linked-invocation",
      "asserted-process-result"
    ],
    "wasm_imports_policy": "Reject before artifact publication until every transitive source identity is pinned and wasm32 linked. Source imports are not Wasm guest host imports.",
    "capability_limitations": {
      "java": "full canonical-root resolver and linked runtime must be executed",
      "llvm": "host-only scalar source graph is not module/actor/wasm32 parity",
      "net": "host resolver is not CIL/Native AOT binding",
      "forge": "host resolver is not Forge IR module linking",
      "wasm": "fail-closed rejection is not linked module parity"
    }
  }
}
