{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oreslang restricted pure signed i64 proof IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contractId",
    "function",
    "semantics",
    "source",
    "assumptions",
    "obligations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "ores-proof-ir"
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,79}$"
    },
    "function": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integer",
        "ownership",
        "effects"
      ],
      "properties": {
        "integer": {
          "const": "signed-i64"
        },
        "ownership": {
          "const": "pure"
        },
        "effects": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "blob",
        "path",
        "mode",
        "typedDigest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^ores-truffle-oreslang/"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "blob": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "mode": {
          "enum": [
            "reviewed-blob",
            "checked-ast",
            "typed-hir",
            "typed-mir"
          ]
        },
        "typedDigest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "logic",
          "expected",
          "querySha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,79}$"
          },
          "kind": {
            "enum": [
              "proof",
              "negative-control"
            ]
          },
          "logic": {
            "const": "QF_BV"
          },
          "expected": {
            "enum": [
              "unsat",
              "sat"
            ]
          },
          "querySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
