{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/atto-lang/atto-common-source/contracts/analysis/unified-typed-effects-v1.schema.json",
  "title": "AttoLang typed effect summary v1 — untrusted interoperability envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "assurance",
    "producer",
    "entries",
    "functions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "attolang.typed-effects/v1"
    },
    "assurance": {
      "const": "COMPILER_TYPED_IR_OBSERVATION_NOT_RUNTIME_CERTIFICATION"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "revision",
        "source_sha256",
        "typed_ir_digest"
      ],
      "properties": {
        "backend": {
          "enum": [
            "java",
            "llvm",
            "net",
            "wasm",
            "forge",
            "rs",
            "cranelift",
            "js",
            "hdl",
            "atto",
            "realtime",
            "reference"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "typed_ir_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "closure",
          "direct_effects",
          "calls",
          "work",
          "declared_bound"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "closure": {
            "enum": [
              "complete",
              "unknown"
            ]
          },
          "direct_effects": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/effect"
            }
          },
          "declared_bound": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/effect"
                }
              }
            ]
          },
          "calls": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "targets",
                "phase"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "direct",
                    "sealed_dynamic",
                    "unknown"
                  ]
                },
                "targets": {
                  "type": "array",
                  "maxItems": 128,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "phase": {
                  "enum": [
                    "immediate",
                    "latent_start",
                    "latent_poll",
                    "cleanup"
                  ]
                }
              }
            }
          },
          "work": {
            "enum": [
              "bounded_claim",
              "unbounded",
              "unknown"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.$:/-]{0,127}$"
    },
    "effect": {
      "enum": [
        "throw",
        "raise",
        "panic",
        "suspend",
        "block",
        "alloc",
        "state.read",
        "state.write",
        "io",
        "io.file.read",
        "io.file.write",
        "io.net",
        "io.env",
        "io.clock",
        "io.entropy",
        "ffi",
        "nondet",
        "spawns",
        "actor.send"
      ]
    }
  }
}
