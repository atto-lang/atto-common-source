{
  "schema": "atto.annotation-targets.v2",
  "version": 2,
  "status": "PROPOSED_REFERENCE_CONTRACT_ONLY_NOT_GUEST_EXECUTED",
  "purpose": "Registry and fail-closed admission model for all declaration and type-use targets; not a compiler implementation.",
  "supersedesLegacyV1": false,
  "legacyContract": "ores-truffle-oreslang/oreslang-source.java contracts/v1/ANNOTATION_ADMISSION_V1.md (draft PR #2275)",
  "sourceForm": "@Name or @Name(positional, named: constant) preceding an applicable declaration; type-use/return annotations require explicit grammar approval.",
  "targets": [
    "package",
    "module",
    "import",
    "class",
    "struct",
    "record",
    "interface",
    "trait",
    "enum",
    "enum_variant",
    "actor",
    "actor_handler",
    "actor_message",
    "function",
    "method",
    "constructor",
    "field",
    "property",
    "parameter",
    "return_type",
    "type_alias",
    "type_use",
    "generic_parameter",
    "local_binding",
    "closure",
    "macro_definition"
  ],
  "phases": [
    "metadata",
    "expand",
    "proof",
    "abi"
  ],
  "constraints": {
    "resolvedIdentity": "package-qualified annotation type, exact case-sensitive identifier; no confusable or display-name matching",
    "unknown": "reject (including metadata) until schema and target are registered",
    "wrongTarget": "reject before lowering",
    "duplicates": "reject unless declared repeatable; no last-wins",
    "arguments": "constant-only; no side effects, actor execution, reflection, dynamic loading, I/O, network, clock or randomness; type-exact; labels unique; positional/name collisions rejected",
    "limits": {
      "maxAnnotationsPerDeclaration": 64,
      "maxArgumentsPerAnnotation": 8,
      "maxArgumentStringBytes": 4096,
      "maxExpansionDepth": 32,
      "maxExpansionNodes": 10000,
      "maxConstEvalSteps": 100000
    },
    "order": "Resolve and validate targets; expand hygienically; resolve/type check; ownership/borrow/effect checks; verify security and ABI; lower for each backend.",
    "retention": "Every compiler-affecting use survives typed AST/HIR and is consumed with traceable proof or fails; no silent erase. Metadata-only uses cannot change behavior.",
    "authority": "Annotations do not mint capabilities; RequiresPermission/CallerRole are checks, never grants. Tenant, actor, supervisor CONTROL, sealed-state, FFI and sandbox policies remain authoritative.",
    "aot": "No runtime reflection, dynamic code generation or runtime annotation interpreter is required. Full AOT backends must reject unlowered semantic annotation before IR or emitted artifact.",
    "hotReload": "Changed definition/version/expansion fingerprint invalidates typed/effect/ownership/ABI incremental and hot-reload caches.",
    "securitySpoofingRejected": [
      "@Trusted",
      "@Unsafe",
      "@AllowAll",
      "@Untrusted"
    ],
    "validationEvidences": [
      "parser-reject-with-diagnostic",
      "type-ownership-effect-proof",
      "pre-IR-guard",
      "no-artifact-negative",
      "exact-head-executed-guest-positive",
      "AOT-no-reflection"
    ]
  },
  "backendStatus": {
    "java": "NOT_EXECUTED_THIS_CONTRACT",
    "llvm": "NOT_EXECUTED_THIS_CONTRACT",
    "wasm": "NOT_EXECUTED_THIS_CONTRACT",
    "forge": "NOT_EXECUTED_THIS_CONTRACT",
    "net": "NOT_EXECUTED_THIS_CONTRACT"
  },
  "legacyObservations": {
    "java": "Draft admission PR describes parser-level @Ret, module @BuildMetadata, and field @FromJson paths; not verified runtime parity.",
    "llvm": "Draft admission PR describes limited native actor annotation gates; not a Wasm guest guarantee.",
    "wasm": "Draft source preflight rejects unlowered annotations.",
    "net": "Draft scalar and structured parsers reject unlowered annotations.",
    "forge": "Draft scalar and native-call parsers reject unlowered annotations."
  },
