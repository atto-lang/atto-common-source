{
  "schema": "atto.macro-aot-jit.v1",
  "status": "CONTRACT_ONLY_NO_BACKEND_EXECUTION_CREDIT",
  "normative_dependencies": [
    "oreslang.macro-semantics.v1",
    "oreslang.aot-language-closure.v1"
  ],
  "backend_repositories": {
    "java-graal": "ores-truffle-oreslang/oreslang-source.java",
    "llvm": "ores-truffle-oreslang/oreslang-source.llvm",
    "dotnet": "ores-truffle-oreslang/oreslang-source.net",
    "wasm": "ores-truffle-oreslang/oreslang-source.wasm",
    "cranelift": "ores-truffle-oreslang/oreslang-source.cranelift"
  },
  "execution_modes": {
    "aot": {
      "guest_source_compiled_to_program_specific_artifact": true,
      "runtime_guest_source_compiler": false,
      "runtime_macro_expander": false,
      "guest_interpreter_fallback": false,
      "runtime_jit_required": false,
      "require_linked_guest_executable_or_closed_wasm_module": true,
      "relocatable_object_alone_is_insufficient": true
    },
    "jit": {
      "optional": true,
      "same_closed_program_semantics": true,
      "may_optimize_closed_executable_ir": true,
      "may_expand_macros_at_runtime": false,
      "may_mint_new_type_or_capability_identity": false,
      "does_not_satisfy_aot_release_gate": true
    },
    "hybrid": {
      "optional": true,
      "aot_baseline_mandatory": true,
      "jit_cannot_change_semantics": true,
      "jit_can_be_disabled_without_recompiling_source": true,
      "does_not_replace_strict_aot_proof": true
    }
  },
  "compile_time_gates": [
    "typed_ast_not_source_string_substitution",
    "deterministic_bounded_comptime",
    "no_environment_time_network_or_unlisted_file_authority",
    "exact_hygiene_provenance_and_no_capability_minting",
    "generated_ast_rechecked_for_type_effect_ownership_actor_capability",
    "finite_generic_witness_dispatch_and_actor_handler_closure",
    "all_macro_nodes_and_compiler_meta_types_erased_before_codegen",
    "macro_and_compiler_abi_change_invalidates_incremental_dependents",
    "no_automatic_runtime_fallback_on_expansion_budget_or_codegen_failure"
  ],
  "proof_layers": [
    "offline_model",
    "host_runtime",
    "compiler_admission",
    "guest_execution",
    "binary_aot"
  ],
  "cases": [
    {
      "id": "MA001",
      "expected": "execute",
      "expected_stdout": "42",
      "source": "define macro literal(Const<int> value) -> Syntax<Expr> { return quote(value); }\nfnc main() -> int { return literal!(const 40 + 2); }\n"
    },
    {
      "id": "MA002",
      "expected": "execute",
      "expected_stdout": "42",
      "source": "define macro identity(Syntax<Expr> value) -> Syntax<Expr> { return value; }\nfnc main() -> int { return identity!(syntax expr 42); }\n"
    },
    {
      "id": "MA003",
      "expected": "reject",
      "diagnostic_family": "CONST_NOT_CLOSED",
      "source": "define macro literal(Const<int> value) -> Syntax<Expr> { return quote(value); }\nfnc main(int runtime_value) -> int { return literal!(const runtime_value); }\n"
    },
    {
      "id": "MA004",
      "expected": "reject",
      "diagnostic_family": "MACRO_META_ABI_LEAK",
      "source": "fnc main(Syntax<Expr> runtime_value) -> int { return 42; }\n"
    },
    {
      "id": "MA005",
      "expected": "reject",
      "diagnostic_family": "MACRO_VISIBILITY",
      "source": "define module Producer as\n  define macro secret(Const<int> value) -> Syntax<Expr> { return quote(value); }\nend\ndefine module Consumer as\n  fnc main() -> int { return Producer.secret!(const 42); }\nend\n"
    },
    {
      "id": "MA006",
      "expected": "reject",
      "diagnostic_family": "NO_RUNTIME_MACRO_FALLBACK",
      "source": "define macro unsupported(Const<int> value) -> Syntax<Expr> { return eval(value); }\nfnc main() -> int { return unsupported!(const 42); }\n"
    },
    {
      "id": "MA007",
      "expected": "execute",
      "expected_stdout": "42",
      "source": "fnc main() -> int { return 42; }\n"
    }
  ],
  "minimum_matrix": {
    "aot_backend_ids": [
      "java-graal",
      "llvm",
      "dotnet",
      "wasm",
      "cranelift"
    ],
    "aot_cases": [
      "MA001",
      "MA002",
      "MA003",
      "MA004",
      "MA005",
      "MA006",
      "MA007"
    ],
    "jit_differential_when_available": [
      "MA001",
      "MA002",
      "MA007"
    ],
    "aot_required_even_if_jit_passes": true,
    "unsupported_is_not_pass": true,
    "no_runner_steps_is_not_executed": true,
    "native_compiler_rejection_is_not_guest_execution": true,
    "native_image_of_interpreter_is_not_program_specific_guest_aot": true,
    "wasm_guest_module_not_equivalent_to_aot_host_machine_image": true,
    "structural_receipt_validation_not_authentication": true,
    "native_scalar_object_does_not_qualify_full_aot": true,
    "wasm_module_is_guest_aot_not_native_host_image": true
  }
}
