// Expected exit 10 when Java member lowering invokes native collections.atto.
pub fnc main(): int {
  let mut Array<int> values = new Array<int>();
  values.add(1);
  values.add(2);
  values.add(3);
  return values.map(|int value| -> int { return value * 2; })
      .filter(|int value| -> bool { return value > 2; })
      .reduce(0, |int sum, int value| -> int { return sum + value; });
}
