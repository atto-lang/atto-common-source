; Checked signed i64 shift admission. Count is a signed i64, not masked.
(set-logic QF_BV)
(set-option :timeout 10000)
(declare-const n (_ BitVec 64))
(declare-const a (_ BitVec 64))
(define-fun admitted () Bool (and (bvsge n (_ bv0 64)) (bvslt n (_ bv64 64))))
(define-fun guard () Bool (bvult n (_ bv64 64)))
(define-fun safe () (_ BitVec 64) (ite guard n (_ bv0 64)))
(define-fun low6 () (_ BitVec 64) ((_ zero_extend 58) ((_ extract 5 0) n)))
(echo "P01 unsigned guard iff signed range")
(push) (assert (not (= guard admitted))) (check-sat) (pop)
(echo "P02 safe count always in range")
(push) (assert (not (bvult safe (_ bv64 64)))) (check-sat) (pop)
(echo "P03 admitted count preserved")
(push) (assert admitted) (assert (not (= safe n))) (check-sat) (pop)
(echo "P04 masked hardware count agrees only on admitted inputs")
(push) (assert admitted) (assert (not (= low6 n))) (check-sat) (pop)
(echo "P05 left shift is low 64 bits of widened shift")
(push) (assert admitted) (assert (not (= (bvshl a safe) ((_ extract 63 0) (bvshl ((_ zero_extend 64) a) ((_ zero_extend 64) n)))))) (check-sat) (pop)
(echo "P06 logical right shift agrees with zero-extended shift")
(push) (assert admitted) (assert (not (= (bvlshr a safe) ((_ extract 63 0) (bvlshr ((_ zero_extend 64) a) ((_ zero_extend 64) n)))))) (check-sat) (pop)
(echo "P07 arithmetic right shift agrees with sign-extended shift")
(push) (assert admitted) (assert (not (= (bvashr a safe) ((_ extract 63 0) (bvashr ((_ sign_extend 64) a) ((_ zero_extend 64) n)))))) (check-sat) (pop)
(echo "M01 signed upper-only guard admits negative counts")
(push) (assert (bvslt n (_ bv64 64))) (assert (not admitted)) (check-sat) (pop)
(echo "M02 narrowing before admission hides invalid counts")
(push) (assert (bvult low6 (_ bv64 64))) (assert (not admitted)) (check-sat) (pop)
(echo "M03 logical and arithmetic right shift differ")
(push) (assert admitted) (assert (not (= (bvlshr a n) (bvashr a n)))) (check-sat) (pop)
(echo "R01 zero count admitted")
(push) (assert (= n (_ bv0 64))) (assert admitted) (check-sat) (pop)
(echo "R02 sixty-three admitted")
(push) (assert (= n (_ bv63 64))) (assert admitted) (check-sat) (pop)
(echo "R03 sixty-four denied")
(push) (assert (= n (_ bv64 64))) (assert (not admitted)) (check-sat) (pop)
(echo "R04 negative count denied")
(push) (assert (= n (_ bv18446744073709551615 64))) (assert (not admitted)) (check-sat) (pop)
