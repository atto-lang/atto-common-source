; Signed i64 counts; fixed 64-bit two's-complement result patterns.
(set-logic QF_BV)
(set-option :timeout 10000)
(declare-const a (_ BitVec 64))
(declare-const n (_ BitVec 64))
(define-fun zero () (_ BitVec 64) (_ bv0 64))
(define-fun limit () (_ BitVec 64) (_ bv64 64))
(define-fun valid () Bool (and (bvsge n zero) (bvslt n limit)))
(define-fun wide-count () (_ BitVec 128) ((_ zero_extend 64) n))
(echo "P01 unsigned guard equals signed interval")
(push) (assert (not (= (bvult n limit) valid))) (check-sat) (pop)
(echo "P02 left shift equals low half of widened shift")
(push) (assert valid) (assert (not (= (bvshl a n) ((_ extract 63 0) (bvshl ((_ zero_extend 64) a) wide-count))))) (check-sat) (pop)
(echo "P03 logical right equals zero-extended widened shift")
(push) (assert valid) (assert (not (= (bvlshr a n) ((_ extract 63 0) (bvlshr ((_ zero_extend 64) a) wide-count))))) (check-sat) (pop)
(echo "P04 arithmetic right equals sign-extended widened shift")
(push) (assert valid) (assert (not (= (bvashr a n) ((_ extract 63 0) (bvashr ((_ sign_extend 64) a) wide-count))))) (check-sat) (pop)
(echo "P05 zero count preserves every bit")
(push) (assert (= n zero)) (assert (or (not (= (bvshl a n) a)) (not (= (bvlshr a n) a)) (not (= (bvashr a n) a)))) (check-sat) (pop)
(echo "M01 masking invalid distances admits invalid input")
(push) (assert (not valid)) (assert (bvult (bvand n (_ bv63 64)) limit)) (check-sat) (pop)
(echo "M02 signed upper bound alone admits negative count")
(push) (assert (not valid)) (assert (bvslt n limit)) (check-sat) (pop)
(echo "M03 arithmetic and logical right are not interchangeable")
(push) (assert valid) (assert (not (= (bvashr a n) (bvlshr a n)))) (check-sat) (pop)
(echo "R01 last legal count")
(push) (assert (= n (_ bv63 64))) (assert valid) (check-sat) (pop)
(echo "R02 first too-large count")
(push) (assert (= n limit)) (assert (not valid)) (check-sat) (pop)
(echo "R03 negative one")
(push) (assert (= n #xffffffffffffffff)) (assert (not valid)) (check-sat) (pop)
(echo "R04 minimum signed count")
(push) (assert (= n #x8000000000000000)) (assert (not valid)) (check-sat) (pop)
