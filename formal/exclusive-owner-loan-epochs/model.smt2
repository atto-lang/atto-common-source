; Abstract single allocation, two owning places, two loan slots.
; Mathematical generations do not wrap. Opaque capability identity is assumed.
(set-logic QF_LIA)
(set-option :timeout 10000)
(declare-const o Int) (declare-const g Int)
(declare-const k1 Int) (declare-const k2 Int)
(declare-const e1 Int) (declare-const e2 Int)
(declare-const on Int) (declare-const gn Int)
(declare-const k1n Int) (declare-const k2n Int)
(declare-const e1n Int) (declare-const e2n Int)
(declare-const loc Int) (declare-const og Int)
(declare-const dest Int) (declare-const slot Int)
(declare-const le Int) (declare-const kind Int)
; o=0 retired, o=1/2 live owner place; k=0 empty, 1 read, 2 write.
(define-fun inv ((O Int) (G Int) (K1 Int) (K2 Int) (E1 Int) (E2 Int)) Bool
 (and (<= 0 O 2) (>= G 0) (>= E1 0) (>= E2 0)
      (<= 0 K1 2) (<= 0 K2 2)
      (=> (= O 0) (and (= K1 0) (= K2 0)))
      (=> (= K1 2) (= K2 0)) (=> (= K2 2) (= K1 0))))
(define-fun pre () Bool (inv o g k1 k2 e1 e2))
(define-fun post () Bool (inv on gn k1n k2n e1n e2n))
(define-fun no-loans () Bool (and (= k1 0) (= k2 0)))
(define-fun owner-valid () Bool (and (not (= o 0)) (= loc o) (= og g)))
(define-fun owner-write () Bool (and owner-valid no-loans))
(define-fun owner-read () Bool (and owner-valid (not (= k1 2)) (not (= k2 2))))
(define-fun loan-valid () Bool
 (and (not (= o 0)) (= og g)
  (or (and (= slot 1) (not (= k1 0)) (= le e1))
      (and (= slot 2) (not (= k2 0)) (= le e2)))))
(define-fun loan-write () Bool (and loan-valid (or (and (= slot 1) (= k1 2)) (and (= slot 2) (= k2 2)))))
(define-fun keep-slots () Bool (and (= k1n k1) (= k2n k2) (= e1n e1) (= e2n e2)))
(define-fun allocate () Bool (and (= o 0) no-loans (<= 1 dest 2) (= on dest) (= gn (+ g 1)) keep-slots))
(define-fun take-owner () Bool (and owner-write (<= 1 dest 2) (not (= dest o)) (= on dest) (= gn (+ g 1)) keep-slots))
(define-fun drop-owner () Bool (and owner-write (= on 0) (= gn (+ g 1)) keep-slots))
(define-fun borrow-loan () Bool
 (and owner-valid (or (= kind 1) (= kind 2)) (= on o) (= gn g)
      (ite (= kind 2) no-loans (and (not (= k1 2)) (not (= k2 2))))
      (or (and (= slot 1) (= k1 0) (= k1n kind) (= e1n (+ e1 1)) (= k2n k2) (= e2n e2))
          (and (= slot 2) (= k2 0) (= k2n kind) (= e2n (+ e2 1)) (= k1n k1) (= e1n e1)))))
(define-fun release-loan () Bool
 (and loan-valid (= on o) (= gn g) (= e1n e1) (= e2n e2)
      (or (and (= slot 1) (= k1n 0) (= k2n k2))
          (and (= slot 2) (= k2n 0) (= k1n k1)))))
(define-fun step () Bool (or allocate take-owner drop-owner borrow-loan release-loan))
(echo "P01 initial invariant")
(push) (assert (and (= o 0) (= g 0) (= k1 0) (= k2 0) (= e1 0) (= e2 0))) (assert (not pre)) (check-sat) (pop)
(echo "P02 allocation preserves invariant")
(push) (assert pre) (assert allocate) (assert (not post)) (check-sat) (pop)
(echo "P03 transfer preserves invariant")
(push) (assert pre) (assert take-owner) (assert (not post)) (check-sat) (pop)
(echo "P04 retirement preserves invariant")
(push) (assert pre) (assert drop-owner) (assert (not post)) (check-sat) (pop)
(echo "P05 loan issuance preserves invariant")
(push) (assert pre) (assert borrow-loan) (assert (not post)) (check-sat) (pop)
(echo "P06 loan release preserves invariant")
(push) (assert pre) (assert release-loan) (assert (not post)) (check-sat) (pop)
(echo "P07 all modeled steps preserve generations monotonically")
(push) (assert pre) (assert step) (assert (or (< gn g) (< e1n e1) (< e2n e2))) (check-sat) (pop)
(echo "P08 live loan excludes transfer and retirement")
(push) (assert pre) (assert (not no-loans)) (assert (or take-owner drop-owner)) (check-sat) (pop)
(echo "P09 stale owner generation cannot be admitted")
(push) (assert pre) (assert (< og g)) (assert owner-valid) (check-sat) (pop)
(echo "P10 stale loan generation cannot be admitted")
(push) (assert pre) (assert (< og g)) (assert loan-valid) (check-sat) (pop)
(echo "P11 stale loan slot epoch cannot be admitted")
(push) (assert pre) (assert (or (and (= slot 1) (< le e1)) (and (= slot 2) (< le e2)))) (assert loan-valid) (check-sat) (pop)
(echo "P12 owner write and loan access cannot coexist")
(push) (assert pre) (assert owner-write) (assert loan-valid) (check-sat) (pop)
(echo "P13 owner read and writer loan cannot coexist")
(push) (assert pre) (assert owner-read) (assert loan-write) (check-sat) (pop)
(echo "P14 retired allocation admits no access")
(push) (assert pre) (assert (= o 0)) (assert (or owner-valid loan-valid)) (check-sat) (pop)
(echo "P15 transfer invalidates prior owner generation")
(push) (assert pre) (assert take-owner) (assert (= gn og)) (check-sat) (pop)
(echo "P16 reissued loan slot increments its epoch")
(push) (assert pre) (assert borrow-loan) (assert (or (and (= slot 1) (<= e1n e1)) (and (= slot 2) (<= e2n e2)))) (check-sat) (pop)
(echo "M01 mutable issuance ignoring other readers violates invariant")
(push) (assert pre) (assert (= o 1)) (assert (= k1 0)) (assert (= k2 1)) (assert (not (inv o g 2 k2 (+ e1 1) e2))) (check-sat) (pop)
(echo "M02 retirement ignoring live loan violates invariant")
(push) (assert pre) (assert (= o 1)) (assert (= k1 1)) (assert (not (inv 0 (+ g 1) k1 k2 e1 e2))) (check-sat) (pop)
(echo "M03 two moves without generation advance admit original owner token")
(push) (assert pre) (assert owner-write) (assert (<= 1 dest 2)) (assert (not (= dest o)))
; Mutant moves to dest, then back to original loc, without changing generation.
(assert (= on dest)) (assert (= gn g)) (assert keep-slots)
(assert (= loc o)) (assert (= og gn)) (check-sat) (pop)
(echo "M04 missing loan slot epoch invalidation admits old epoch on reuse")
(push) (assert pre) (assert (= o 1)) (assert (= k1 0)) (assert (= slot 1)) (assert (= le e1)) (assert (= e1n e1)) (assert (= k1n 1)) (assert (= le e1n)) (check-sat) (pop)
(echo "R01 second read loan admitted alongside first")
(push) (assert pre) (assert (= k1 1)) (assert (= k2 0)) (assert (= slot 2)) (assert (= kind 1)) (assert borrow-loan) (assert (= k1n 1)) (assert (= k2n 1)) (assert post) (check-sat) (pop)
(echo "R02 exclusive writer")
(push) (assert pre) (assert borrow-loan) (assert (= kind 2)) (assert post) (check-sat) (pop)
(echo "R03 owner transfer")
(push) (assert pre) (assert take-owner) (assert post) (check-sat) (pop)
(echo "R04 allocation with a nonzero prior generation admissible")
(push) (assert pre) (assert (= g 7)) (assert allocate) (assert post) (check-sat) (pop)
(echo "R05 release of valid read loan")
(push) (assert pre) (assert (= k1 1)) (assert (= slot 1)) (assert release-loan) (assert post) (check-sat) (pop)
