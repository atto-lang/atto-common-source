; Atto checked i64 guard model (not compiler-generated IR).
(set-logic QF_BV)
(set-option :timeout 10000)
(declare-const a (_ BitVec 64))
(declare-const b (_ BitVec 64))
(define-fun zero () (_ BitVec 64) #x0000000000000000)
(define-fun one () (_ BitVec 64) #x0000000000000001)
(define-fun negone () (_ BitVec 64) #xffffffffffffffff)
(define-fun min64 () (_ BitVec 64) #x8000000000000000)
(define-fun max64 () (_ BitVec 64) #x7fffffffffffffff)
(define-fun sign ((x (_ BitVec 64))) Bool (bvslt x zero))
(define-fun add64 () (_ BitVec 64) (bvadd a b))
(define-fun sub64 () (_ BitVec 64) (bvsub a b))
(define-fun add_overflow () Bool (and (= (sign a) (sign b)) (not (= (sign a) (sign add64)))))
(define-fun sub_overflow () Bool (and (not (= (sign a) (sign b))) (not (= (sign a) (sign sub64)))))
(define-fun wide_add () (_ BitVec 65) (bvadd ((_ sign_extend 1) a) ((_ sign_extend 1) b)))
(define-fun wide_sub () (_ BitVec 65) (bvsub ((_ sign_extend 1) a) ((_ sign_extend 1) b)))
(define-fun outside ((x (_ BitVec 65))) Bool (or (bvslt x ((_ sign_extend 1) min64)) (bvsgt x ((_ sign_extend 1) max64))))
(define-fun div_zero () Bool (= b zero))
(define-fun div_overflow () Bool (and (= a min64) (= b negone)))
(define-fun div_bad () Bool (or div_zero div_overflow))
(define-fun safe_divisor () (_ BitVec 64) (ite div_bad one b))
(define-fun safe_remainder_divisor () (_ BitVec 64) (ite (or (= b zero) (= b negone)) one b))
(define-fun invalid_sdiv ((x (_ BitVec 64)) (y (_ BitVec 64))) Bool (or (= y zero) (and (= x min64) (= y negone))))
(echo "P01 add overflow iff widened result outside range")
(push) (assert (not (= add_overflow (outside wide_add)))) (check-sat) (pop)
(echo "P02 subtract overflow iff widened result outside range")
(push) (assert (not (= sub_overflow (outside wide_sub)))) (check-sat) (pop)
(echo "P03 negation overflow iff operand is minimum")
(push) (assert (not (= (= a min64) (outside (bvneg ((_ sign_extend 1) a)))))) (check-sat) (pop)
(echo "P04 accepted add preserves mathematical result")
(push) (assert (not add_overflow)) (assert (not (= ((_ sign_extend 1) add64) wide_add))) (check-sat) (pop)
(echo "P05 accepted subtract preserves mathematical result")
(push) (assert (not sub_overflow)) (assert (not (= ((_ sign_extend 1) sub64) wide_sub))) (check-sat) (pop)
(echo "P06 division error cases disjoint")
(push) (assert (and div_zero div_overflow)) (check-sat) (pop)
(echo "P07 substituted divisor never invalid even on rejected paths")
(push) (assert (invalid_sdiv a safe_divisor)) (check-sat) (pop)
(echo "P08 accepted division retains original divisor")
(push) (assert (not div_bad)) (assert (not (= safe_divisor b))) (check-sat) (pop)
(echo "P09 remainder substituted divisor never zero or min over minus one")
(push) (assert (invalid_sdiv a safe_remainder_divisor)) (check-sat) (pop)
(echo "P10 accepted non-minus-one remainder retains original divisor")
(push) (assert (and (not div_zero) (not (= b negone)))) (assert (not (= safe_remainder_divisor b))) (check-sat) (pop)
(echo "M01 mutant add ignores overflow")
(push) (assert add_overflow) (check-sat) (pop)
(echo "M02 mutant subtract uses addition predicate")
(push) (assert (not (= add_overflow sub_overflow))) (check-sat) (pop)
(echo "M03 mutant division substitutes only zero")
(push) (assert (invalid_sdiv a (ite div_zero one b))) (check-sat) (pop)
(echo "M04 mutant division substitutes only overflow")
(push) (assert (invalid_sdiv a (ite div_overflow one b))) (check-sat) (pop)
(echo "M05 mutant remainder substitutes only minus one")
(push) (assert (invalid_sdiv a (ite (= b negone) one b))) (check-sat) (pop)
(echo "R01 valid division reachable")
(push) (assert (not div_bad)) (check-sat) (pop)
(echo "R02 zero division reachable")
(push) (assert div_zero) (check-sat) (pop)
(echo "R03 overflow division reachable")
(push) (assert div_overflow) (check-sat) (pop)
