; Conditional correctness of Euclidean modulus correction after truncating remainder.
; r is supplied by remainder implementation: proof does NOT establish r = srem(a,b).
(set-logic QF_BV)
(set-option :timeout 10000)
(declare-const b (_ BitVec 64))
(declare-const r (_ BitVec 64))
(define-fun zero () (_ BitVec 64) #x0000000000000000)
(define-fun wide_zero () (_ BitVec 65) (_ bv0 65))
(define-fun bw () (_ BitVec 65) ((_ sign_extend 1) b))
(define-fun rw () (_ BitVec 65) ((_ sign_extend 1) r))
(define-fun magnitude () (_ BitVec 65) (ite (bvslt bw wide_zero) (bvneg bw) bw))
(define-fun admitted () Bool (and (not (= b zero)) (bvsgt rw (bvneg magnitude)) (bvslt rw magnitude)))
(define-fun corrected () (_ BitVec 64) (ite (bvsge r zero) r (ite (bvsgt b zero) (bvadd r b) (bvsub r b))))
(define-fun mw () (_ BitVec 65) ((_ sign_extend 1) corrected))
(define-fun reference () (_ BitVec 65) (ite (bvslt rw wide_zero) (bvadd rw magnitude) rw))
(echo "P01 correction agrees with widened reference")
(push) (assert admitted) (assert (not (= mw reference))) (check-sat) (pop)
(echo "P02 result is nonnegative and below divisor magnitude")
(push) (assert admitted) (assert (not (and (bvsge mw wide_zero) (bvslt mw magnitude)))) (check-sat) (pop)
(echo "P03 nonnegative remainder unchanged")
(push) (assert admitted) (assert (bvsge r zero)) (assert (not (= corrected r))) (check-sat) (pop)
(echo "P04 negative remainder corrected by exactly one divisor magnitude")
(push) (assert admitted) (assert (bvslt r zero)) (assert (not (= (bvsub mw rw) magnitude))) (check-sat) (pop)
(echo "P05 unit divisor requires zero remainder and modulus")
(push) (assert admitted) (assert (= magnitude (_ bv1 65))) (assert (not (and (= r zero) (= corrected zero)))) (check-sat) (pop)
(echo "M01 uncorrected negative remainder violates range")
(push) (assert admitted) (assert (bvslt r zero)) (check-sat) (pop)
(echo "M02 always add divisor disagrees for negative divisor")
(push) (assert admitted) (assert (bvslt r zero)) (assert (not (= (bvadd r b) corrected))) (check-sat) (pop)
(echo "M03 signed abs of minimum cannot represent magnitude")
(push) (assert admitted) (assert (not (= ((_ sign_extend 1) (ite (bvslt b zero) (bvneg b) b)) magnitude))) (check-sat) (pop)
(echo "R01 minimum divisor with negative remainder reachable")
(push) (assert admitted) (assert (= b #x8000000000000000)) (assert (bvslt r zero)) (check-sat) (pop)
(echo "R02 positive divisor with negative remainder reachable")
(push) (assert admitted) (assert (bvsgt b zero)) (assert (bvslt r zero)) (check-sat) (pop)
