; Signed 128-bit exact-product narrowing contract. The product is abstract.
; This does not prove the multiplier or the compiler lowering.
(set-logic QF_BV)
(set-option :timeout 10000)
(declare-const product (_ BitVec 128))
(define-fun low () (_ BitVec 64) ((_ extract 63 0) product))
(define-fun high () (_ BitVec 64) ((_ extract 127 64) product))
(define-fun minimum () (_ BitVec 128) #xffffffffffffffff8000000000000000)
(define-fun maximum () (_ BitVec 128) #x00000000000000007fffffffffffffff)
(define-fun outside () Bool (or (bvslt product minimum) (bvsgt product maximum)))
(define-fun signfill () (_ BitVec 64) (ite (bvslt low #x0000000000000000) #xffffffffffffffff #x0000000000000000))
(define-fun overflow () Bool (not (= high signfill)))
(echo "P01 overflow iff exact product outside signed i64")
(push) (assert (not (= overflow outside))) (check-sat) (pop)
(echo "P02 accepted product equals sign-extended result")
(push) (assert (not overflow)) (assert (not (= product ((_ sign_extend 64) low)))) (check-sat) (pop)
(echo "P03 every signed i64 value is accepted")
(push) (assert (= product ((_ sign_extend 64) low))) (assert overflow) (check-sat) (pop)
(echo "P04 accepted negative result has all-one high half")
(push) (assert (not overflow)) (assert (bvslt low #x0000000000000000)) (assert (not (= high #xffffffffffffffff))) (check-sat) (pop)
(echo "M01 high-half-zero-only guard is incorrect")
(push) (assert (not (= (not (= high #x0000000000000000)) outside))) (check-sat) (pop)
(echo "M02 low-sign-only guard is incorrect")
(push) (assert (not (= (bvslt low #x0000000000000000) outside))) (check-sat) (pop)
(echo "M03 accepting either zero or all-one high half is incorrect")
(push) (assert (not (= (not (or (= high #x0000000000000000) (= high #xffffffffffffffff))) outside))) (check-sat) (pop)
(echo "R01 exact signed minimum accepted")
(push) (assert (= product minimum)) (assert (not overflow)) (check-sat) (pop)
(echo "R02 exact signed maximum accepted")
(push) (assert (= product maximum)) (assert (not overflow)) (check-sat) (pop)
(echo "R03 one above maximum rejected")
(push) (assert (= product (bvadd maximum (_ bv1 128)))) (assert overflow) (check-sat) (pop)
(echo "R04 one below minimum rejected")
(push) (assert (= product (bvsub minimum (_ bv1 128)))) (assert overflow) (check-sat) (pop)
